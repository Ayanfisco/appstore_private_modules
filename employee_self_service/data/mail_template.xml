<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="mail_template_ess_portal_invite" model="mail.template">
            <field name="name">ESS Portal: Employee Invitation</field>
            <field name="model_id" ref="hr.model_hr_employee"/>
            <field name="subject">Your Employee Self-Service Portal is Ready</field>
            <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="email_to">{{ object.work_email or object.private_email }}</field>
            <field name="body_html" type="html"><![CDATA[
            <div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;">
                <div style="background: #017e84; padding: 28px 32px; border-radius: 8px 8px 0 0;">
                    <h2 style="color: #fff; margin: 0;">Welcome to Your Self-Service Portal</h2>
                </div>
                <div style="background: #fff; padding: 28px 32px; border: 1px solid #e0e0e0; border-top: none; border-radius: 0 0 8px 8px;">
                    <p>Dear <strong>{{ object.name }}</strong>,</p>
                    <p>Your HR team has set up an Employee Self-Service portal account for you.</p>
                    <ul>
                        <li>🏖️ Request time off and track leave balances</li>
                        <li>💰 Submit and track expense claims</li>
                        <li>🧾 View and download your payslips</li>
                        <li>👤 Update your contact and emergency information</li>
                    </ul>
                    <div style="text-align: center; margin: 32px 0;">
                        <a href="{{ object.get_base_url() }}/my/ess"
                           style="background: #017e84; color: #fff; padding: 14px 32px;
                                  border-radius: 6px; text-decoration: none; font-weight: bold;">
                            Access My Portal
                        </a>
                    </div>
                    <p style="color: #666; font-size: 13px;">
                        Sign in with: <strong>{{ object.work_email or object.private_email }}</strong><br/>
                        Use "Forgot Password" if you haven't set a password yet.
                    </p>
                    <p style="color: #999; font-size: 12px;">
                        Sent by {{ object.company_id.name }}.
                    </p>
                </div>
            </div>
            ]]></field>
            <field name="auto_delete" eval="True"/>
        </record>

    </data>
</odoo>