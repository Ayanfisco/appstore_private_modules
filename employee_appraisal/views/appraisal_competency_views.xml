<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_appraisal_competency_form" model="ir.ui.view">
        <field name="name">appraisal.competency.form</field>
        <field name="model">appraisal.competency</field>
        <field name="arch" type="xml">
            <form string="Competency">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="category"/>
                        </group>
                        <group>
                            <field name="weightage"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_appraisal_competency_list" model="ir.ui.view">
        <field name="name">appraisal.competency.list</field>
        <field name="model">appraisal.competency</field>
        <field name="arch" type="xml">
            <list string="Competencies">
                <field name="name"/>
                <field name="category"/>
                <field name="weightage"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_appraisal_competency" model="ir.actions.act_window">
        <field name="name">Competencies</field>
        <field name="res_model">appraisal.competency</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>