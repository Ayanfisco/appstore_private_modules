<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Student Sequence -->
        <record id="seq_educore_student" model="ir.sequence">
            <field name="name">Student Sequence</field>
            <field name="code">educore.student</field>
            <field name="prefix">STU</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <!-- Teacher Sequence -->
        <record id="seq_educore_teacher" model="ir.sequence">
            <field name="name">Teacher Sequence</field>
            <field name="code">educore.teacher</field>
            <field name="prefix">TCH</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <!-- Enrollment Sequence -->
        <record id="seq_educore_enrollment" model="ir.sequence">
            <field name="name">Enrollment Sequence</field>
            <field name="code">educore.enrollment</field>
            <field name="prefix">ENR</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <!-- Fee Sequence -->
        <record id="seq_educore_fee" model="ir.sequence">
            <field name="name">Fee Sequence</field>
            <field name="code">educore.fee</field>
            <field name="prefix">FEE</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>
    </data>
</odoo>