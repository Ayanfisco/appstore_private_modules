<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_student_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Student Information</h2>
                        <div class="row mt32 mb32">
                            <div class="col-6">
                                <strong>Student ID:</strong> <span t-field="o.student_id"/><br/>
                                <strong>Name:</strong> <span t-field="o.full_name"/><br/>
                                <strong>Date of Birth:</strong> <span t-field="o.date_of_birth"/><br/>
                                <strong>Age:</strong> <span t-field="o.age"/><br/>
                                <strong>Gender:</strong> <span t-field="o.gender"/><br/>
                            </div>
                            <div class="col-6">
                                <strong>Email:</strong> <span t-field="o.email"/><br/>
                                <strong>Phone:</strong> <span t-field="o.phone"/><br/>
                                <strong>Class:</strong> <span t-field="o.class_id.name"/><br/>
                                <strong>Status:</strong> <span t-field="o.state"/><br/>
                            </div>
                        </div>

                        <h3>Guardian Information</h3>
                        <div class="row mb32">
                            <div class="col-12">
                                <strong>Name:</strong> <span t-field="o.guardian_name"/><br/>
                                <strong>Phone:</strong> <span t-field="o.guardian_phone"/><br/>
                                <strong>Email:</strong> <span t-field="o.guardian_email"/><br/>
                            </div>
                        </div>

                        <h3>Academic Performance</h3>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Exam</th>
                                    <th>Marks Obtained</th>
                                    <th>Total Marks</th>
                                    <th>Percentage</th>
                                    <th>Grade</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="o.grade_ids" t-as="grade">
                                    <tr>
                                        <td><span t-field="grade.exam_id.name"/></td>
                                        <td><span t-field="grade.marks_obtained"/></td>
                                        <td><span t-field="grade.total_marks"/></td>
                                        <td><span t-field="grade.percentage"/>%</td>
                                        <td><span t-field="grade.grade"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <div class="row mt32">
                            <div class="col-6">
                                <strong>Total Attendance:</strong> <span t-field="o.total_attendance"/><br/>
                                <strong>Attendance Percentage:</strong> <span t-field="o.attendance_percentage"/>%<br/>
                            </div>
                            <div class="col-6">
                                <strong>Total Fees:</strong> <span t-field="o.total_fees"/><br/>
                                <strong>Paid Fees:</strong> <span t-field="o.paid_fees"/><br/>
                                <strong>Outstanding:</strong> <span t-field="o.outstanding_fees"/><br/>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>