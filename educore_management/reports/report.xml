<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Student Report -->
    <record id="report_educore_student" model="ir.actions.report">
        <field name="name">Student Report</field>
        <field name="model">educore.student</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">educore_management.report_student_template</field>
        <field name="report_file">educore_management.report_student_template</field>
        <field name="binding_model_id" ref="model_educore_student"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Student - %s' % (object.full_name)</field>
    </record>
</odoo>