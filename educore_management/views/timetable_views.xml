<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Timetable List View -->
    <record id="view_educore_timetable_list" model="ir.ui.view">
        <field name="name">educore.timetable.list</field>
        <field name="model">educore.timetable</field>
        <field name="arch" type="xml">
            <list string="Timetable" sample="1">
                <field name="class_id"/>
                <field name="course_id"/>
                <field name="teacher_id"/>
                <field name="day_of_week"/>
                <field name="start_time" widget="float_time"/>
                <field name="end_time" widget="float_time"/>
                <field name="room_number"/>
                <field name="state" decoration-success="state == 'active'" decoration-info="state == 'draft'"/>
            </list>
        </field>
    </record>

    <!-- Timetable Form View -->
    <record id="view_educore_timetable_form" model="ir.ui.view">
        <field name="name">educore.timetable.form</field>
        <field name="model">educore.timetable</field>
        <field name="arch" type="xml">
            <form string="Timetable">
                <header>
                    <button name="action_activate" string="Activate" type="object" invisible="state != 'draft'"
                            class="oe_highlight"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state == 'cancelled'"
                            class="btn-danger"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="class_id"/>
                            <field name="course_id"/>
                            <field name="teacher_id"/>
                        </group>
                        <group>
                            <field name="day_of_week"/>
                            <field name="start_time" widget="float_time"/>
                            <field name="end_time" widget="float_time"/>
                            <field name="room_number"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Timetable Calendar View -->
    <record id="view_educore_timetable_calendar" model="ir.ui.view">
        <field name="name">educore.timetable.calendar</field>
        <field name="model">educore.timetable</field>
        <field name="arch" type="xml">
            <calendar string="Timetable"
                      date_start="start_datetime"
                      date_stop="end_datetime"
                      color="class_id"
                      mode="week"
                      event_open_popup="true">
                <field name="course_id"/>
                <field name="teacher_id"/>
                <field name="room_number"/>
                <field name="day_of_week"/>
            </calendar>
        </field>
    </record>

    <!-- Timetable Search View -->
    <record id="view_educore_timetable_search" model="ir.ui.view">
        <field name="name">educore.timetable.search</field>
        <field name="model">educore.timetable</field>
        <field name="arch" type="xml">
            <search string="Search Timetable">
                <field name="class_id"/>
                <field name="course_id"/>
                <field name="teacher_id"/>
                <filter string="Active" name="active" domain="[('state', '=', 'active')]"/>
                <filter string="Monday" name="monday" domain="[('day_of_week', '=', 'monday')]"/>
                <filter string="Tuesday" name="tuesday" domain="[('day_of_week', '=', 'tuesday')]"/>
                <filter string="Wednesday" name="wednesday" domain="[('day_of_week', '=', 'wednesday')]"/>
                <filter string="Thursday" name="thursday" domain="[('day_of_week', '=', 'thursday')]"/>
                <filter string="Friday" name="friday" domain="[('day_of_week', '=', 'friday')]"/>
                <group expand="0" string="Group By">
                    <filter string="Class" name="group_class" context="{'group_by': 'class_id'}"/>
                    <filter string="Teacher" name="group_teacher" context="{'group_by': 'teacher_id'}"/>
                    <filter string="Day" name="group_day" context="{'group_by': 'day_of_week'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Timetable Action -->
    <record id="action_educore_timetable" model="ir.actions.act_window">
        <field name="name">Timetable</field>
        <field name="res_model">educore.timetable</field>
        <field name="view_mode">list,form,calendar</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first timetable entry!
            </p>
        </field>
    </record>

</odoo>