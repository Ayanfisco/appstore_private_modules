<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Teacher List View -->
    <record id="view_educore_teacher_list" model="ir.ui.view">
        <field name="name">educore.teacher.list</field>
        <field name="model">educore.teacher</field>
        <field name="arch" type="xml">
            <list string="Teachers" sample="1">
                <field name="teacher_id"/>
                <field name="photo" widget="image" width="50px" height="50px"/>
                <field name="full_name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="qualification"/>
                <field name="specialization"/>
                <field name="joining_date"/>
                <field name="state" decoration-success="state == 'active'" decoration-info="state == 'draft'"/>
            </list>
        </field>
    </record>

    <!-- Teacher Form View -->
    <record id="view_educore_teacher_form" model="ir.ui.view">
        <field name="name">educore.teacher.form</field>
        <field name="model">educore.teacher</field>
        <field name="arch" type="xml">
            <form string="Teacher">
                <header>
                    <button name="action_activate" string="Activate" type="object" invisible="state != 'draft'"
                            class="oe_highlight"/>
                    <button name="action_set_on_leave" string="Set On Leave" type="object" invisible="state != 'active'"
                            class="btn-warning"/>
                    <button name="action_resign" string="Mark as Resigned" type="object" invisible="state == 'resigned'"
                            class="btn-danger"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active"/>
                </header>
                <sheet>
                    <field name="photo" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1>
                            <field name="full_name" readonly="1"/>
                        </h1>
                        <h2>
                            <field name="teacher_id" readonly="1"/>
                        </h2>
                    </div>
                    <group>
                        <group string="Personal Information">
                            <field name="first_name"/>
                            <field name="last_name"/>
                            <field name="date_of_birth"/>
                            <field name="gender"/>
                        </group>
                        <group string="Contact Information">
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="address"/>
                        </group>
                    </group>
                    <group>
                        <group string="Professional Information">
                            <field name="qualification"/>
                            <field name="specialization"/>
                            <field name="experience_years"/>
                            <field name="joining_date"/>
                        </group>
                        <group string="Salary Information">
                            <field name="currency_id" invisible="1"/>
                            <field name="salary"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Courses">
                            <field name="course_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="credits"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Classes">
                            <field name="class_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="section"/>
                                    <field name="student_count"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Timetable">
                            <field name="timetable_ids">
                                <list>
                                    <field name="class_id"/>
                                    <field name="course_id"/>
                                    <field name="day_of_week"/>
                                    <field name="start_time" widget="float_time"/>
                                    <field name="end_time" widget="float_time"/>
                                    <field name="room_number"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Teacher Kanban View -->
    <record id="view_educore_teacher_kanban" model="ir.ui.view">
        <field name="name">educore.teacher.kanban</field>
        <field name="model">educore.teacher</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="teacher_id"/>
                <field name="full_name"/>
                <field name="photo"/>
                <field name="specialization"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_image">
                                <img t-attf-src="/web/image/educore.teacher/{{record.id.raw_value}}/photo"
                                     alt="Teacher"/>
                            </div>
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="full_name"/>
                                </strong>
                                <div class="o_kanban_record_subtitle">
                                    <field name="teacher_id"/>
                                    -
                                    <field name="specialization"/>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_right">
                                        <field name="state" widget="label_selection"
                                               options="{'classes': {'active': 'success', 'draft': 'info'}}"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Teacher Search View -->
    <record id="view_educore_teacher_search" model="ir.ui.view">
        <field name="name">educore.teacher.search</field>
        <field name="model">educore.teacher</field>
        <field name="arch" type="xml">
            <search string="Search Teachers">
                <field name="teacher_id"/>
                <field name="full_name"/>
                <field name="specialization"/>
                <filter string="Active" name="active" domain="[('state', '=', 'active')]"/>
                <filter string="On Leave" name="on_leave" domain="[('state', '=', 'on_leave')]"/>
                <group expand="0" string="Group By">
                    <filter string="Specialization" name="group_specialization"
                            context="{'group_by': 'specialization'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Teacher Action -->
    <record id="action_educore_teacher" model="ir.actions.act_window">
        <field name="name">Teachers</field>
        <field name="res_model">educore.teacher</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first teacher!
            </p>
        </field>
    </record>

</odoo>