<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Attendance List View -->
    <record id="view_educore_attendance_list" model="ir.ui.view">
        <field name="name">educore.attendance.list</field>
        <field name="model">educore.attendance</field>
        <field name="arch" type="xml">
            <list string="Attendance" sample="1" editable="bottom">
                <field name="student_id"/>
                <field name="class_id"/>
                <field name="date"/>
                <field name="status" decoration-success="status == 'present'" decoration-danger="status == 'absent'" decoration-warning="status == 'late'"/>
                <field name="remarks"/>
            </list>
        </field>
    </record>

    <!-- Attendance Form View -->
    <record id="view_educore_attendance_form" model="ir.ui.view">
        <field name="name">educore.attendance.form</field>
        <field name="model">educore.attendance</field>
        <field name="arch" type="xml">
            <form string="Attendance">
                <sheet>
                    <group>
                        <group>
                            <field name="student_id"/>
                            <field name="class_id"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="status"/>
                        </group>
                    </group>
                    <group>
                        <field name="remarks" placeholder="Add remarks..."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Attendance Search View -->
    <record id="view_educore_attendance_search" model="ir.ui.view">
        <field name="name">educore.attendance.search</field>
        <field name="model">educore.attendance</field>
        <field name="arch" type="xml">
            <search string="Search Attendance">
                <field name="student_id"/>
                <field name="class_id"/>
                <field name="date"/>
                <filter string="Present" name="present" domain="[('status', '=', 'present')]"/>
                <filter string="Absent" name="absent" domain="[('status', '=', 'absent')]"/>
                <filter string="Today" name="today" domain="[('date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="This Week" name="this_week" domain="[('date', '&gt;=', (context_today() - relativedelta(weeks=1)).strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter string="Student" name="group_student" context="{'group_by': 'student_id'}"/>
                    <filter string="Class" name="group_class" context="{'group_by': 'class_id'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'date'}"/>
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Attendance Action -->
    <record id="action_educore_attendance" model="ir.actions.act_window">
        <field name="name">Attendance</field>
        <field name="res_model">educore.attendance</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_today': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Mark attendance for students!
            </p>
        </field>
    </record>

</odoo>