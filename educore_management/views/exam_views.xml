<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Exam List View -->
    <record id="view_educore_exam_list" model="ir.ui.view">
        <field name="name">educore.exam.list</field>
        <field name="model">educore.exam</field>
        <field name="arch" type="xml">
            <list string="Exams" sample="1">
                <field name="name"/>
                <field name="course_id"/>
                <field name="exam_date"/>
                <field name="exam_type"/>
                <field name="total_marks"/>
                <field name="passing_marks"/>
                <field name="state" decoration-success="state == 'graded'" decoration-info="state == 'scheduled'"/>
            </list>
        </field>
    </record>

    <!-- Exam Form View -->
    <record id="view_educore_exam_form" model="ir.ui.view">
        <field name="name">educore.exam.form</field>
        <field name="model">educore.exam</field>
        <field name="arch" type="xml">
            <form string="Exam">
                <header>
                    <button name="action_schedule" string="Schedule" type="object" invisible="state != 'draft'" class="oe_highlight"/>
                    <button name="action_conduct" string="Mark as Conducted" type="object" invisible="state != 'scheduled'" class="btn-primary"/>
                    <button name="action_grade" string="Mark as Graded" type="object" invisible="state != 'conducted'" class="btn-success"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,scheduled,conducted,graded"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Exam Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="course_id"/>
                            <field name="exam_type"/>
                            <field name="exam_date"/>
                        </group>
                        <group>
                            <field name="exam_time" widget="float_time"/>
                            <field name="duration"/>
                            <field name="total_marks"/>
                            <field name="passing_marks"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Grades">
                            <field name="grade_ids">
                                <list>
                                    <field name="student_id"/>
                                    <field name="marks_obtained"/>
                                    <field name="total_marks"/>
                                    <field name="percentage"/>
                                    <field name="grade"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Exam Search View -->
    <record id="view_educore_exam_search" model="ir.ui.view">
        <field name="name">educore.exam.search</field>
        <field name="model">educore.exam</field>
        <field name="arch" type="xml">
            <search string="Search Exams">
                <field name="name"/>
                <field name="course_id"/>
                <filter string="Scheduled" name="scheduled" domain="[('state', '=', 'scheduled')]"/>
                <filter string="Conducted" name="conducted" domain="[('state', '=', 'conducted')]"/>
                <filter string="Graded" name="graded" domain="[('state', '=', 'graded')]"/>
                <group expand="0" string="Group By">
                    <filter string="Course" name="group_course" context="{'group_by': 'course_id'}"/>
                    <filter string="Exam Type" name="group_type" context="{'group_by': 'exam_type'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Exam Action -->
    <record id="action_educore_exam" model="ir.actions.act_window">
        <field name="name">Exams</field>
        <field name="res_model">educore.exam</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first exam!
            </p>
        </field>
    </record>

</odoo>