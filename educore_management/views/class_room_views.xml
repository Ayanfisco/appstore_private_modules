<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Class List View -->
    <record id="view_educore_class_list" model="ir.ui.view">
        <field name="name">educore.class.list</field>
        <field name="model">educore.class</field>
        <field name="arch" type="xml">
            <list string="Classes" sample="1">
                <field name="name"/>
                <field name="code"/>
                <field name="section"/>
                <field name="academic_year"/>
                <field name="class_teacher_id"/>
                <field name="room_number"/>
                <field name="student_count"/>
                <field name="state" decoration-success="state == 'active'" decoration-info="state == 'draft'"/>
            </list>
        </field>
    </record>

    <!-- Class Form View -->
    <record id="view_educore_class_form" model="ir.ui.view">
        <field name="name">educore.class.form</field>
        <field name="model">educore.class</field>
        <field name="arch" type="xml">
            <form string="Class">
                <header>
                    <button name="action_activate" string="Activate" type="object" invisible="state != 'draft'" class="oe_highlight"/>
                    <button name="action_close" string="Close" type="object" invisible="state != 'active'" class="btn-warning"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Class Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="section"/>
                            <field name="academic_year"/>
                        </group>
                        <group>
                            <field name="class_teacher_id"/>
                            <field name="room_number"/>
                            <field name="capacity"/>
                            <field name="student_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Students">
                            <field name="student_ids">
                                <list>
                                    <field name="student_id"/>
                                    <field name="full_name"/>
                                    <field name="email"/>
                                    <field name="phone"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Enrollments">
                            <field name="enrollment_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="student_id"/>
                                    <field name="course_id"/>
                                    <field name="enrollment_date"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Timetable">
                            <field name="timetable_ids">
                                <list>
                                    <field name="course_id"/>
                                    <field name="teacher_id"/>
                                    <field name="day_of_week"/>
                                    <field name="start_time" widget="float_time"/>
                                    <field name="end_time" widget="float_time"/>
                                    <field name="room_number"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Class Search View -->
    <record id="view_educore_class_search" model="ir.ui.view">
        <field name="name">educore.class.search</field>
        <field name="model">educore.class</field>
        <field name="arch" type="xml">
            <search string="Search Classes">
                <field name="name"/>
                <field name="code"/>
                <field name="class_teacher_id"/>
                <filter string="Active" name="active" domain="[('state', '=', 'active')]"/>
                <group expand="0" string="Group By">
                    <filter string="Academic Year" name="group_year" context="{'group_by': 'academic_year'}"/>
                    <filter string="Class Teacher" name="group_teacher" context="{'group_by': 'class_teacher_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Class Action -->
    <record id="action_educore_class" model="ir.actions.act_window">
        <field name="name">Classes</field>
        <field name="res_model">educore.class</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first class!
            </p>
        </field>
    </record>

</odoo>
