<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Student List View -->
    <record id="view_educore_student_list" model="ir.ui.view">
        <field name="name">educore.student.list</field>
        <field name="model">educore.student</field>
        <field name="arch" type="xml">
            <list string="Students" sample="1">
                <field name="student_id"/>
                <field name="photo" widget="image" width="50px" height="50px"/>
                <field name="full_name"/>
                <field name="class_id"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="guardian_name"/>
                <field name="admission_date"/>
                <field name="state" decoration-success="state == 'active'" decoration-info="state == 'draft'"
                       decoration-danger="state == 'withdrawn'"/>
            </list>
        </field>
    </record>

    <!-- Student Form View -->
    <record id="view_educore_student_form" model="ir.ui.view">
        <field name="name">educore.student.form</field>
        <field name="model">educore.student</field>
        <field name="arch" type="xml">
            <form string="Student">
                <header>
                    <button name="action_activate" string="Activate" type="object" invisible="state != 'draft'"
                            class="oe_highlight"/>
                    <button name="action_suspend" string="Suspend" type="object" invisible="state != 'active'"
                            class="btn-warning"/>
                    <button name="action_graduate" string="Graduate" type="object" invisible="state != 'active'"
                            class="btn-success"/>
                    <button name="action_withdraw" string="Withdraw" type="object"
                            invisible="state not in ['active', 'suspended']" class="btn-danger"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,graduated"/>
                </header>
                <sheet>
                    <field name="photo" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1>
                            <field name="full_name" readonly="1"/>
                        </h1>
                        <h2>
                            <field name="student_id" readonly="1"/>
                        </h2>
                    </div>
                    <group>
                        <group string="Personal Information">
                            <field name="first_name"/>
                            <field name="last_name"/>
                            <field name="date_of_birth"/>
                            <field name="age"/>
                            <field name="gender"/>
                            <field name="blood_group"/>
                            <field name="nationality"/>
                        </group>
                        <group string="Contact Information">
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="address"/>
                        </group>
                    </group>
                    <group>
                        <group string="Guardian Information">
                            <field name="guardian_name"/>
                            <field name="guardian_phone"/>
                            <field name="guardian_email"/>
                        </group>
                        <group string="Academic Information">
                            <field name="class_id"/>
                            <field name="admission_date"/>
                        </group>
                    </group>
                    <group>
                        <group string="Statistics">
                            <field name="total_attendance"/>
                            <field name="attendance_percentage"/>
                        </group>
                        <group string="Fee Information">
                            <field name="currency_id" invisible="1"/>
                            <field name="total_fees"/>
                            <field name="paid_fees"/>
                            <field name="outstanding_fees"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Enrollments">
                            <field name="enrollment_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="course_id"/>
                                    <field name="class_id"/>
                                    <field name="enrollment_date"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Attendance">
                            <field name="attendance_ids">
                                <list>
                                    <field name="date"/>
                                    <field name="class_id"/>
                                    <field name="status"/>
                                    <field name="remarks"/>
                                </list>
                            </field>
                        </page>
                        <page string="Grades">
                            <field name="grade_ids">
                                <list>
                                    <field name="exam_id"/>
                                    <field name="marks_obtained"/>
                                    <field name="total_marks"/>
                                    <field name="percentage"/>
                                    <field name="grade"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Fees">
                            <field name="fee_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="fee_type"/>
                                    <field name="amount"/>
                                    <field name="due_date"/>
                                    <field name="payment_date"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <!-- Student Kanban View -->
    <record id="view_educore_student_kanban" model="ir.ui.view">
        <field name="name">educore.student.kanban</field>
        <field name="model">educore.student</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="student_id"/>
                <field name="full_name"/>
                <field name="photo"/>
                <field name="class_id"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_image">
                                <img t-attf-src="/web/image/educore.student/{{record.id.raw_value}}/photo"
                                     alt="Student"/>
                            </div>
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="full_name"/>
                                </strong>
                                <div class="o_kanban_record_subtitle">
                                    <field name="student_id"/>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="class_id"/>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <field name="state" widget="label_selection"
                                               options="{'classes': {'active': 'success', 'draft': 'info'}}"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Student Search View -->
    <record id="view_educore_student_search" model="ir.ui.view">
        <field name="name">educore.student.search</field>
        <field name="model">educore.student</field>
        <field name="arch" type="xml">
            <search string="Search Students">
                <field name="student_id"/>
                <field name="full_name"/>
                <field name="class_id"/>
                <field name="guardian_name"/>
                <filter string="Active" name="active" domain="[('state', '=', 'active')]"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Male" name="male" domain="[('gender', '=', 'male')]"/>
                <filter string="Female" name="female" domain="[('gender', '=', 'female')]"/>
                <group expand="0" string="Group By">
                    <filter string="Class" name="group_class" context="{'group_by': 'class_id'}"/>
                    <filter string="Gender" name="group_gender" context="{'group_by': 'gender'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Student Action -->
    <record id="action_educore_student" model="ir.actions.act_window">
        <field name="name">Students</field>
        <field name="res_model">educore.student</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first student!
            </p>
            <p>
                Click the create button to add a new student to the system.
            </p>
        </field>
    </record>

</odoo>
