<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Fee List View -->
    <record id="view_educore_fee_list" model="ir.ui.view">
        <field name="name">educore.fee.list</field>
        <field name="model">educore.fee</field>
        <field name="arch" type="xml">
            <list string="Fees" sample="1">
                <field name="name"/>
                <field name="student_id"/>
                <field name="fee_type"/>
                <field name="amount"/>
                <field name="due_date"/>
                <field name="payment_date"/>
                <field name="academic_year"/>
                <field name="state" decoration-success="state == 'paid'" decoration-danger="state == 'overdue'" decoration-warning="state == 'pending'"/>
            </list>
        </field>
    </record>

    <!-- Fee Form View -->
    <record id="view_educore_fee_form" model="ir.ui.view">
        <field name="name">educore.fee.form</field>
        <field name="model">educore.fee</field>
        <field name="arch" type="xml">
            <form string="Fee">
                <header>
                    <button name="action_confirm" string="Confirm" type="object" invisible="state != 'draft'" class="oe_highlight"/>
                    <button name="action_pay" string="Mark as Paid" type="object" invisible="state != 'pending'" class="btn-success"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state in ['paid', 'cancelled']" class="btn-danger"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,pending,paid"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="student_id"/>
                            <field name="fee_type"/>
                            <field name="academic_year"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="amount"/>
                            <field name="due_date"/>
                            <field name="payment_date"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" placeholder="Add description..."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Fee Search View -->
    <record id="view_educore_fee_search" model="ir.ui.view">
        <field name="name">educore.fee.search</field>
        <field name="model">educore.fee</field>
        <field name="arch" type="xml">
            <search string="Search Fees">
                <field name="name"/>
                <field name="student_id"/>
                <filter string="Pending" name="pending" domain="[('state', '=', 'pending')]"/>
                <filter string="Paid" name="paid" domain="[('state', '=', 'paid')]"/>
                <filter string="Overdue" name="overdue" domain="[('state', '=', 'overdue')]"/>
                <group expand="0" string="Group By">
                    <filter string="Student" name="group_student" context="{'group_by': 'student_id'}"/>
                    <filter string="Fee Type" name="group_type" context="{'group_by': 'fee_type'}"/>
                    <filter string="Academic Year" name="group_year" context="{'group_by': 'academic_year'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Fee Action -->
    <record id="action_educore_fee" model="ir.actions.act_window">
        <field name="name">Fees</field>
        <field name="res_model">educore.fee</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first fee record!
            </p>
        </field>
    </record>

</odoo>
