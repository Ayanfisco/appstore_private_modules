<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_prescription_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <!-- Header -->
                        <div class="row" style="border-bottom: 2px solid #1a7f5a; padding-bottom:10px; margin-bottom:20px;">
                            <div class="col-8">
                                <h2 style="color:#1a7f5a; margin:0;">MEDICAL PRESCRIPTION</h2>
                                <p style="margin:0; font-size:12px; color:#666;">
                                    Ref: <strong><t t-esc="doc.name"/></strong> &amp;nbsp;|&amp;nbsp;
                                    Date: <strong><t t-esc="doc.prescription_date"/></strong>
                                </p>
                            </div>
                            <div class="col-4 text-right">
                                <p style="margin:0;"><span class="badge badge-pill" style="background:#1a7f5a; color:white; padding:6px 14px; font-size:13px;">
                                    <t t-esc="doc.state.upper()"/>
                                </span></p>
                            </div>
                        </div>

                        <!-- Patient and Doctor -->
                        <div class="row" style="margin-bottom:20px;">
                            <div class="col-6" style="background:#f7faf9; padding:12px; border-radius:6px;">
                                <h5 style="color:#1a7f5a; margin-bottom:6px;">PATIENT</h5>
                                <p style="margin:2px 0;"><strong><t t-esc="doc.patient_id.name"/></strong></p>
                                <p style="margin:2px 0; font-size:12px;">ID: <t t-esc="doc.patient_id.patient_id"/></p>
                                <p style="margin:2px 0; font-size:12px;">
                                    Age: <t t-esc="doc.patient_id.age"/> &amp;nbsp;|&amp;nbsp;
                                    Gender: <t t-esc="doc.patient_id.gender"/>
                                </p>
                                <p style="margin:2px 0; font-size:12px;">
                                    Blood Group: <t t-esc="doc.patient_id.blood_group or 'N/A'"/>
                                </p>
                                <t t-if="doc.patient_id.allergies">
                                    <p style="margin:4px 0; color:#c0392b; font-size:12px;">
                                        ⚠ Allergies: <t t-esc="doc.patient_id.allergies"/>
                                    </p>
                                </t>
                            </div>
                            <div class="col-6" style="background:#f7faf9; padding:12px; border-radius:6px; margin-left:8px;">
                                <h5 style="color:#1a7f5a; margin-bottom:6px;">PRESCRIBING DOCTOR</h5>
                                <p style="margin:2px 0;"><strong>Dr. <t t-esc="doc.doctor_id.name"/></strong></p>
                                <p style="margin:2px 0; font-size:12px;"><t t-esc="doc.doctor_id.specialization"/></p>
                                <p style="margin:2px 0; font-size:12px;"><t t-esc="doc.doctor_id.qualification or ''"/></p>
                                <p style="margin:2px 0; font-size:12px;">Reg No: <t t-esc="doc.doctor_id.medical_council_no or 'N/A'"/></p>
                                <p style="margin:2px 0; font-size:12px;"><t t-esc="doc.doctor_id.phone or ''"/></p>
                            </div>
                        </div>

                        <!-- Diagnosis -->
                        <t t-if="doc.diagnosis">
                            <div style="background:#fffbe6; border-left:4px solid #f39c12; padding:8px 12px; margin-bottom:16px; border-radius:0 6px 6px 0;">
                                <strong>Diagnosis / Indication:</strong> <t t-esc="doc.diagnosis"/>
                            </div>
                        </t>

                        <!-- Medications -->
                        <h5 style="color:#1a7f5a; border-bottom:1px solid #ddd; padding-bottom:4px;">&#x211E; MEDICATIONS</h5>
                        <table class="table table-sm" style="font-size:12px; margin-bottom:20px;">
                            <thead style="background:#1a7f5a; color:white;">
                                <tr>
                                    <th>#</th>
                                    <th>Medication</th>
                                    <th>Dosage</th>
                                    <th>Route</th>
                                    <th>Frequency</th>
                                    <th>Duration</th>
                                    <th>Qty</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="doc.line_ids" t-as="line">
                                    <tr>
                                        <td><t t-esc="line_index + 1"/></td>
                                        <td><strong><t t-esc="line.medication_name"/></strong>
                                            <t t-if="line.instructions">
                                                <br/><small style="color:#666;"><t t-esc="line.instructions"/></small>
                                            </t>
                                        </td>
                                        <td><t t-esc="line.dosage or ''"/></td>
                                        <td><t t-esc="line.route or ''"/></td>
                                        <td><t t-esc="line.frequency or ''"/></td>
                                        <td><t t-esc="line.duration or ''"/></td>
                                        <td><t t-esc="line.quantity"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <!-- Instructions -->
                        <t t-if="doc.notes">
                            <div style="background:#f0f7ff; padding:10px 14px; border-radius:6px; margin-bottom:16px;">
                                <strong>Instructions to Patient:</strong><br/>
                                <span style="font-size:12px;"><t t-esc="doc.notes"/></span>
                            </div>
                        </t>

                        <!-- Validity -->
                        <t t-if="doc.valid_until">
                            <p style="font-size:11px; color:#888;">Valid until: <t t-esc="doc.valid_until"/></p>
                        </t>

                        <!-- Signature -->
                        <div class="row" style="margin-top:40px;">
                            <div class="col-6">
                                <div style="border-top:1px solid #333; padding-top:4px; width:180px; text-align:center;">
                                    <p style="margin:0; font-size:11px;">Doctor Signature &amp; Stamp</p>
                                    <p style="margin:0; font-size:11px;"><strong>Dr. <t t-esc="doc.doctor_id.name"/></strong></p>
                                </div>
                            </div>
                            <div class="col-6 text-right" style="font-size:11px; color:#aaa;">
                                <p>Generated by Clinic Management System</p>
                                <p>This prescription is valid only with doctor's signature and stamp.</p>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_prescription" model="ir.actions.report">
        <field name="name">Medical Prescription</field>
        <field name="model">clinic.prescription</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">clinic_management_tech.report_prescription_document</field>
        <field name="report_file">clinic_management_tech.report_prescription_document</field>
        <field name="binding_model_id" ref="model_clinic_prescription"/>
        <field name="binding_type">report</field>
        <!-- <field name="paperformat_id" ref="base.paperformat_a4"/> -->
    </record>
</odoo>
