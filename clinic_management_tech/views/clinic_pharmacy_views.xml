<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_clinic_pharmacy_form" model="ir.ui.view">
        <field name="name">clinic.pharmacy.dispensing.form</field>
        <field name="model">clinic.pharmacy.dispensing</field>
        <field name="arch" type="xml">
            <form string="Pharmacy Dispensing">
                <header>
                    <button name="action_dispense" string="Dispense" type="object"
                            invisible="state != 'pending'" class="oe_highlight"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ['dispensed','cancelled']"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,dispensed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_stock_moves" type="object"
                                class="oe_stat_button" icon="fa-truck"
                                invisible="not stock_move_count">
                            <field name="stock_move_count" widget="statinfo" string="Stock Moves"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="patient_id"/>
                            <field name="prescription_id"/>
                            <field name="pharmacist_id"/>
                            <field name="dispense_date"/>
                        </group>
                        <group>
                            <field name="total_amount" readonly="1"/>
                        </group>
                    </group>
                    <separator string="Medications to Dispense"/>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="product_id"/>
                            <field name="medication_name"/>
                            <field name="dosage"/>
                            <field name="quantity"/>
                            <field name="unit_price"/>
                            <field name="total_price" readonly="1"/>
                            <field name="instructions"/>
                        </list>
                    </field>
                    <group string="Pharmacist Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="view_clinic_pharmacy_list" model="ir.ui.view">
        <field name="name">clinic.pharmacy.dispensing.list</field>
        <field name="model">clinic.pharmacy.dispensing</field>
        <field name="arch" type="xml">
            <list string="Pharmacy Dispensing">
                <field name="name"/>
                <field name="dispense_date"/>
                <field name="patient_id"/>
                <field name="prescription_id"/>
                <field name="pharmacist_id"/>
                <field name="total_amount"/>
                <field name="state" widget="badge"
                       decoration-warning="state == 'pending'"
                       decoration-success="state == 'dispensed'"
                       decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="action_clinic_pharmacy" model="ir.actions.act_window">
        <field name="name">Pharmacy Dispensing</field>
        <field name="res_model">clinic.pharmacy.dispensing</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
