<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_clinic_vital_signs_form" model="ir.ui.view">
        <field name="name">clinic.vital.signs.form</field>
        <field name="model">clinic.vital.signs</field>
        <field name="arch" type="xml">
            <form string="Vital Signs">
                <sheet>
                    <group>
                        <group>
                            <field name="patient_id"/>
                            <field name="consultation_id"/>
                            <field name="recorded_by"/>
                            <field name="recorded_at"/>
                        </group>
                        <group string="Blood Pressure &amp; Heart">
                            <field name="blood_pressure_systolic"/>
                            <field name="blood_pressure_diastolic"/>
                            <field name="blood_pressure_display" readonly="1"/>
                            <field name="pulse_rate"/>
                            <field name="respiratory_rate"/>
                            <field name="spo2"/>
                        </group>
                    </group>
                    <group>
                        <group string="Temperature &amp; Anthropometrics">
                            <field name="temperature"/>
                            <field name="weight"/>
                            <field name="height"/>
                            <field name="bmi" readonly="1"/>
                            <field name="bmi_category" readonly="1"/>
                        </group>
                        <group string="Blood Sugar">
                            <field name="blood_sugar"/>
                            <field name="blood_sugar_type"/>
                            <field name="pain_scale"/>
                            <field name="gcs_score"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_clinic_vital_signs" model="ir.actions.act_window">
        <field name="name">Vital Signs</field>
        <field name="res_model">clinic.vital.signs</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
