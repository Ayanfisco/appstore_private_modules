<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Payment Method: Card (must be created before provider) -->
    <record id="payment_method_card" model="payment.method">
        <field name="name">Paystack</field>
        <field name="code">paystack</field>
        <field name="sequence">1</field>
        <field name="image" type="base64" file="payment_paystack/static/img/paystack_logo.png"/>
    </record>

    <!-- Payment Provider: Paystack -->
    <record id="payment_provider_paystack" model="payment.provider">
        <field name="name">Paystack</field>
        <field name="code">paystack</field>
        <field name="sequence">10</field>
        <field name="state">disabled</field>
        <field name="is_published" eval="False"/>
        <field name="image_128" type="base64" file="payment_paystack/static/img/paystack_logo.png"/>
        <field name="redirect_form_view_id" ref="paystack_form"/>
        <field name="support_manual_capture" eval="False"/>
        <field name="support_refund">full_only</field>
        <field name="support_tokenization" eval="False"/>
        <field name="payment_method_ids" eval="[(4, ref('payment_method_card'))]"/>
    </record>
</odoo>