<odoo>
    <data noupdate="0">
        <!-- Categories -->
        <record id="module_category_vehicle_dealership" model="res.groups.privilege">
            <field name="name">Vehicle Dealership</field>
            <field name="description">Manage vehicle dealership operations</field>
            <field name="sequence">20</field>
        </record>

        <!-- Groups -->
        <record id="group_vehicle_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" ref="module_category_vehicle_dealership"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_vehicle_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="privilege_id" ref="module_category_vehicle_dealership"/>
            <field name="implied_ids" eval="[(4, ref('group_vehicle_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <!-- Record Rules -->
        <record id="vehicle_brand_rule" model="ir.rule">
            <field name="name">Vehicle Brand: Multi-Company</field>
            <field name="model_id" ref="model_vehicle_brand"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <record id="vehicle_model_rule" model="ir.rule">
            <field name="name">Vehicle Model: Multi-Company</field>
            <field name="model_id" ref="model_vehicle_model"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <record id="vehicle_vehicle_rule_user" model="ir.rule">
            <field name="name">Vehicle: User Access</field>
            <field name="model_id" ref="model_vehicle_vehicle"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_vehicle_user'))]"/>
        </record>

        <record id="vehicle_sale_rule_user" model="ir.rule">
            <field name="name">Vehicle Sale: User sees own sales</field>
            <field name="model_id" ref="model_vehicle_sale"/>
            <field name="domain_force">[('salesperson_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_vehicle_user'))]"/>
        </record>

        <record id="vehicle_sale_rule_manager" model="ir.rule">
            <field name="name">Vehicle Sale: Manager sees all</field>
            <field name="model_id" ref="model_vehicle_sale"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_vehicle_manager'))]"/>
        </record>
    </data>
</odoo>