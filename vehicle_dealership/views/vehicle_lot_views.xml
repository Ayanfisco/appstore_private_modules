<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_vehicle_lot_list" model="ir.ui.view">
        <field name="name">vehicle.lot.list</field>
        <field name="model">vehicle.lot</field>
        <field name="arch" type="xml">
            <list string="Lots / Showrooms">
                <field name="name"/>
                <field name="code"/>
                <field name="city"/>
                <field name="manager_id"/>
                <field name="capacity"/>
                <field name="vehicle_count"/>
            </list>
        </field>
    </record>

    <record id="view_vehicle_lot_form" model="ir.ui.view">
        <field name="name">vehicle.lot.form</field>
        <field name="model">vehicle.lot</field>
        <field name="arch" type="xml">
            <form string="Lot / Showroom">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_vehicles" type="object"
                                class="oe_stat_button" icon="fa-car">
                            <field name="vehicle_count" widget="statinfo" string="Vehicles"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Lot/Showroom Name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Details">
                            <field name="code"/>
                            <field name="manager_id"/>
                            <field name="capacity"/>
                            <field name="active"/>
                        </group>
                        <group string="Location">
                            <field name="address"/>
                            <field name="city"/>
                            <field name="state_id"/>
                            <field name="country_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes" placeholder="Additional notes..."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_vehicle_lot_search" model="ir.ui.view">
        <field name="name">vehicle.lot.search</field>
        <field name="model">vehicle.lot</field>
        <field name="arch" type="xml">
            <search string="Search Lots">
                <field name="name"/>
                <field name="code"/>
                <field name="city"/>
                <field name="manager_id"/>
                <group expand="0" string="Group By">
                    <filter string="City" name="group_city" context="{'group_by': 'city'}"/>
                    <filter string="Manager" name="group_manager" context="{'group_by': 'manager_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_vehicle_lot" model="ir.actions.act_window">
        <field name="name">Lots / Showrooms</field>
        <field name="res_model">vehicle.lot</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first lot or showroom
            </p>
            <p>
                Track where each vehicle physically is, across as many lots or showrooms as you operate.
            </p>
        </field>
    </record>
</odoo>
