<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_vehicle_inspection_list" model="ir.ui.view">
        <field name="name">vehicle.inspection.list</field>
        <field name="model">vehicle.inspection</field>
        <field name="arch" type="xml">
            <list string="Vehicle Inspections" sample="1">
                <field name="name"/>
                <field name="vehicle_id"/>
                <field name="inspection_date"/>
                <field name="inspection_type"/>
                <field name="inspector_id" widget="many2one_avatar_user"/>
                <field name="overall_rating"/>
                <field name="passed" widget="boolean_toggle"/>
                <field name="estimated_repair_cost" widget="monetary" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Vehicle Inspection Form View -->
    <record id="view_vehicle_inspection_form" model="ir.ui.view">
        <field name="name">vehicle.inspection.form</field>
        <field name="model">vehicle.inspection</field>
        <field name="arch" type="xml">
            <form string="Vehicle Inspection">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Inspection Information">
                            <field name="vehicle_id"/>
                            <field name="inspection_date"/>
                            <field name="inspection_type"/>
                            <field name="inspector_id" widget="many2one_avatar_user"/>
                        </group>
                        <group string="Overall Assessment">
                            <field name="overall_rating"/>
                            <field name="passed" widget="boolean_toggle"/>
                            <field name="estimated_repair_cost" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="Condition Assessment">
                        <group>
                            <field name="exterior_condition"/>
                            <field name="interior_condition"/>
                            <field name="engine_condition"/>
                        </group>
                        <group>
                            <field name="transmission_condition"/>
                            <field name="tire_condition"/>
                            <field name="brake_condition"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Issues &amp; Recommendations">
                            <group>
                                <field name="issues_found" placeholder="List all issues found during inspection..."/>
                                <field name="recommendations" placeholder="Recommendations for repairs or maintenance..."/>
                            </group>
                        </page>
                        <page string="Photos">
                            <field name="photo_ids" mode="kanban"/>
                        </page>
                        <page string="Report">
                            <group>
                                <field name="report_file" filename="report_filename"/>
                                <field name="report_filename" invisible="1"/>
                            </group>
                        </page>
                        <page string="Additional Notes">
                            <field name="notes" placeholder="Any additional notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Vehicle Inspection Search View -->
    <record id="view_vehicle_inspection_search" model="ir.ui.view">
        <field name="name">vehicle.inspection.search</field>
        <field name="model">vehicle.inspection</field>
        <field name="arch" type="xml">
            <search string="Search Inspections">
                <field name="name"/>
                <field name="vehicle_id"/>
                <field name="inspector_id"/>
                <filter string="Passed" name="passed" domain="[('passed', '=', True)]"/>
                <filter string="Failed" name="failed" domain="[('passed', '=', False)]"/>
                <separator/>
                <filter string="Pre-Purchase" name="pre_purchase" domain="[('inspection_type', '=', 'pre_purchase')]"/>
                <filter string="Pre-Sale" name="pre_sale" domain="[('inspection_type', '=', 'pre_sale')]"/>
                <separator/>
                <filter string="This Month" name="this_month"
                        domain="[('inspection_date', '&gt;=', (context_today() - relativedelta(day=1)).strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter string="Vehicle" name="group_vehicle" context="{'group_by': 'vehicle_id'}"/>
                    <filter string="Inspector" name="group_inspector" context="{'group_by': 'inspector_id'}"/>
                    <filter string="Type" name="group_type" context="{'group_by': 'inspection_type'}"/>
                    <filter string="Inspection Date" name="group_date" context="{'group_by': 'inspection_date'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>