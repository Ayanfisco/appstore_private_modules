<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <!-- Add a "My Vehicles" entry card to the portal home page -->
    <template id="portal_my_home_vehicle" name="Portal My Home: Vehicles" inherit_id="portal.portal_my_home">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-if="vehicle_count">
                <a href="/my/vehicles" class="o_portal_docs_card card mb-3">
                    <div class="card-body">
                        <h5 class="card-title">My Vehicles</h5>
                        <p class="card-text">
                            <span t-esc="vehicle_count"/> vehicle purchase(s)
                        </p>
                    </div>
                </a>
            </t>
        </xpath>
    </template>

    <!-- List of the customer's own vehicle purchases -->
    <template id="portal_my_vehicles" name="My Vehicles">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>

            <t t-call="portal.portal_searchbar">
                <t t-set="title">Vehicles</t>
            </t>

            <t t-if="not sales">
                <div class="alert alert-warning mt-3" role="alert">
                    You don't have any vehicle purchases yet.
                </div>
            </t>
            <t t-else="">
                <table class="table table-hover o_portal_my_doc_table">
                    <thead>
                        <tr class="active">
                            <th>Reference</th>
                            <th>Vehicle</th>
                            <th>Sale Date</th>
                            <th>Status</th>
                            <th class="text-end">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="sales" t-as="sale">
                            <td>
                                <a t-attf-href="/my/vehicles/#{sale.id}">
                                    <t t-esc="sale.name"/>
                                </a>
                            </td>
                            <td>
                                <t t-esc="sale.vehicle_id.display_name"/>
                            </td>
                            <td>
                                <span t-field="sale.sale_date"/>
                            </td>
                            <td>
                                <span t-field="sale.state"/>
                            </td>
                            <td class="text-end">
                                <span t-field="sale.final_price"/>
                            </td>
                        </tr>
                    </tbody>
                </table>
                <t t-call="portal.pager"/>
            </t>
        </t>
    </template>

    <!-- Detail page: one vehicle purchase, its warranty, and its service history -->
    <template id="portal_vehicle_sale_page" name="My Vehicle">
        <t t-call="portal.portal_layout">
            <t t-set="additional_title" t-value="sale.name"/>

            <div class="row">
                <div class="col-lg-8">
                    <h3>
                        <t t-esc="vehicle.display_name"/>
                    </h3>
                    <p class="text-muted">
                        Purchase Reference: <span t-field="sale.name"/>
                    </p>

                    <table class="table table-sm">
                        <tr>
                            <td>Sale Date</td>
                            <td><span t-field="sale.sale_date"/></td>
                        </tr>
                        <tr t-if="sale.delivery_date">
                            <td>Delivery Date</td>
                            <td><span t-field="sale.delivery_date"/></td>
                        </tr>
                        <tr>
                            <td>Status</td>
                            <td><span t-field="sale.state"/></td>
                        </tr>
                        <tr>
                            <td>Final Price</td>
                            <td><span t-field="sale.final_price"/></td>
                        </tr>
                        <tr t-if="sale.warranty_expiry_date">
                            <td>Warranty Expiry</td>
                            <td><span t-field="sale.warranty_expiry_date"/></td>
                        </tr>
                    </table>

                    <h4 class="mt-4">Service History</h4>
                    <t t-if="not service_history">
                        <p class="text-muted">No completed service records yet.</p>
                    </t>
                    <table t-else="" class="table table-sm">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Type</th>
                                <th>Description</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="service_history" t-as="service">
                                <td><span t-field="service.service_date"/></td>
                                <td><span t-field="service.service_type"/></td>
                                <td><span t-field="service.description"/></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </t>
    </template>

</odoo>
