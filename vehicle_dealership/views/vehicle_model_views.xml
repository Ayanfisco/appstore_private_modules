<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_vehicle_model_list" model="ir.ui.view">
        <field name="name">vehicle.model.list</field>
        <field name="model">vehicle.model</field>
        <field name="arch" type="xml">
            <list string="Vehicle Models" sample="1">
                <field name="brand_id"/>
                <field name="name"/>
                <field name="year"/>
                <field name="body_type"/>
                <field name="fuel_type"/>
                <field name="transmission"/>
                <field name="engine_capacity"/>
                <field name="horsepower"/>
                <field name="vehicle_count"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Vehicle Model Form View -->
    <record id="view_vehicle_model_form" model="ir.ui.view">
        <field name="name">vehicle.model.form</field>
        <field name="model">vehicle.model</field>
        <field name="arch" type="xml">
            <form string="Vehicle Model">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name" string="Model Name"/>
                        <h1>
                            <field name="brand_id" placeholder="Brand" options="{'no_create': True}"/>
                            <field name="name" placeholder="Model name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Basic Information">
                            <field name="year"/>
                            <field name="body_type"/>
                            <field name="seating_capacity"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group string="Engine Specifications">
                            <field name="fuel_type"/>
                            <field name="transmission"/>
                            <field name="engine_capacity"/>
                            <field name="horsepower"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description" placeholder="Model description, features, specifications..."/>
                        </page>
                        <page string="Vehicles">
                            <field name="vehicle_count"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Vehicle Model Kanban View -->
    <record id="view_vehicle_model_kanban" model="ir.ui.view">
        <field name="name">vehicle.model.kanban</field>
        <field name="model">vehicle.model</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" sample="1">
                <field name="id"/>
                <field name="name"/>
                <field name="brand_id"/>
                <field name="year"/>
                <field name="body_type"/>
                <field name="fuel_type"/>
                <field name="transmission"/>
                <field name="image"/>
                <templates>
                    <t t-name="card">
                        <div class="o_kanban_image">
                            <img t-att-src="record.image.raw_value ? 'data:image/png;base64,' + record.image.raw_value : '/web/static/img/placeholder.png'"
                                 alt="Model" class="o_image_64_cover"/>
                        </div>
                        <div class="oe_kanban_details">
                            <strong class="o_kanban_record_title">
                                <field name="brand_id"/>
                                <field name="name"/>
                            </strong>
                            <div>Year:
                                <field name="year"/>
                            </div>
                            <div t-if="record.body_type.raw_value">
                                <field name="body_type"/>
                            </div>
                            <div t-if="record.fuel_type.raw_value">
                                <field name="fuel_type"/>
                                |
                                <field name="transmission"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Vehicle Model Search View -->
    <record id="view_vehicle_model_search" model="ir.ui.view">
        <field name="name">vehicle.model.search</field>
        <field name="model">vehicle.model</field>
        <field name="arch" type="xml">
            <search string="Search Models">
                <field name="name"/>
                <field name="brand_id"/>
                <field name="year"/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Archived" name="archived" domain="[('active', '=', False)]"/>
                <separator/>
                <filter string="Electric" name="electric" domain="[('fuel_type', '=', 'electric')]"/>
                <filter string="Hybrid" name="hybrid" domain="[('fuel_type', 'in', ['hybrid', 'plugin_hybrid'])]"/>
<!--                <group expand="0" string="Group By">-->
<!--                    <filter string="Brand" name="group_brand" context="{'group_by': 'brand_id'}"/>-->
<!--                    <filter string="Year" name="group_year" context="{'group_by': 'year'}"/>-->
<!--                    <filter string="Body Type" name="group_body" context="{'group_by': 'body_type'}"/>-->
<!--                    <filter string="Fuel Type" name="group_fuel" context="{'group_by': 'fuel_type'}"/>-->
<!--                </group>-->
            </search>
        </field>
    </record>
    <record id="view_vehicle_model_form_buttons" model="ir.ui.view">
        <field name="name">vehicle.model.form.buttons</field>
        <field name="model">vehicle.model</field>
        <field name="inherit_id" ref="view_vehicle_model_form"/>
        <field name="arch" type="xml">
            <div class="oe_title" position="before">
                <div class="oe_button_box" name="button_box">
                    <button name="%(action_vehicle_vehicle)d" type="action"
                            class="oe_stat_button" icon="fa-list"
                            context="{'search_default_model_id': id}">
                        <field name="vehicle_count" widget="statinfo" string="Vehicles"/>
                    </button>
                </div>
            </div>
        </field>
    </record>

</odoo>