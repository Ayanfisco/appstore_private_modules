<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_vehicle_brand_list" model="ir.ui.view">
        <field name="name">vehicle.brand.list</field>
        <field name="model">vehicle.brand</field>
        <field name="arch" type="xml">
            <list string="Vehicle Brands" sample="1">
                <field name="name"/>
                <field name="code"/>
                <field name="country_id"/>
                <field name="model_count"/>
                <field name="vehicle_count"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Vehicle Brand Form View -->
    <record id="view_vehicle_brand_form" model="ir.ui.view">
        <field name="name">vehicle.brand.form</field>
        <field name="model">vehicle.brand</field>
        <field name="arch" type="xml">
            <form string="Vehicle Brand">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="logo" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name" string="Brand Name"/>
                        <h1>
                            <field name="name" placeholder="e.g., Toyota, Honda, Ford"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="country_id" options="{'no_create': True, 'no_open': True}"/>
                        </group>
                        <group>
                            <field name="active" widget="boolean_toggle"/>
                            <field name="model_count"/>
                            <field name="vehicle_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description" placeholder="Brand description and history..."/>
                        </page>
                        <page string="Models">
                            <field name="model_ids" mode="list">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="year"/>
                                    <field name="body_type"/>
                                    <field name="fuel_type"/>
                                    <field name="transmission"/>
                                    <field name="vehicle_count"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Vehicle Brand Kanban View -->
    <record id="view_vehicle_brand_kanban" model="ir.ui.view">
        <field name="name">vehicle.brand.kanban</field>
        <field name="model">vehicle.brand</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" sample="1">
                <field name="id"/>
                <field name="name"/>
                <field name="code"/>
                <field name="country_id"/>
                <field name="model_count"/>
                <field name="vehicle_count"/>
                <field name="logo"/>
                <templates>
                    <t t-name="card">
                        <div class="o_kanban_image">
                            <img t-att-src="record.logo.raw_value ? 'data:image/png;base64,' + record.logo.raw_value : '/web/static/img/placeholder.png'"
                                 alt="Brand Logo" class="o_image_64_cover"/>
                        </div>
                        <div class="oe_kanban_details">
                            <strong class="o_kanban_record_title">
                                <field name="name"/>
                            </strong>
                            <div t-if="record.code.raw_value">
                                Code:
                                <field name="code"/>
                            </div>
                            <div t-if="record.country_id.raw_value">
                                <field name="country_id"/>
                            </div>
                            <div>
                                Models:
                                <field name="model_count"/>
                                | Vehicles:
                                <field name="vehicle_count"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Vehicle Brand Search View -->
    <record id="view_vehicle_brand_search" model="ir.ui.view">
        <field name="name">vehicle.brand.search</field>
        <field name="model">vehicle.brand</field>
        <field name="arch" type="xml">
            <search string="Search Brands">
                <field name="name"/>
                <field name="code"/>
                <field name="country_id"/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Archived" name="archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Country" name="group_country" context="{'group_by': 'country_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="view_vehicle_brand_form_buttons" model="ir.ui.view">
        <field name="name">vehicle.brand.form.buttons</field>
        <field name="model">vehicle.brand</field>
        <field name="inherit_id" ref="view_vehicle_brand_form"/>
        <field name="arch" type="xml">
            <div class="oe_title" position="before">
                <div class="oe_button_box" name="button_box">
                    <button name="%(action_model_from_brand)d" type="action"
                            class="oe_stat_button" icon="fa-car">
                        <field name="model_count" widget="statinfo" string="Models"/>
                    </button>
                    <button name="%(action_vehicle_from_brand)d" type="action"
                            class="oe_stat_button" icon="fa-list">
                        <field name="vehicle_count" widget="statinfo" string="Vehicles"/>
                    </button>
                </div>
            </div>
        </field>
    </record>
</odoo>