<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="action_vehicle_vehicle" model="ir.actions.act_window">
        <field name="name">Vehicles</field>
        <field name="res_model">vehicle.vehicle</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_available': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first vehicle
            </p>
            <p>
                Click the create button to add a vehicle to your inventory.
            </p>
        </field>
    </record>

    <record id="action_vehicle_brand" model="ir.actions.act_window">
        <field name="name">Vehicle Brands</field>
        <field name="res_model">vehicle.brand</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_vehicle_model" model="ir.actions.act_window">
        <field name="name">Vehicle Models</field>
        <field name="res_model">vehicle.model</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_vehicle_sale" model="ir.actions.act_window">
        <field name="name">Vehicle Sales</field>
        <field name="res_model">vehicle.sale</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_confirmed': 1}</field>
    </record>

    <record id="action_vehicle_purchase" model="ir.actions.act_window">
        <field name="name">Vehicle Purchases</field>
        <field name="res_model">vehicle.purchase</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_vehicle_service" model="ir.actions.act_window">
        <field name="name">Service Records</field>
        <field name="res_model">vehicle.service</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_vehicle_inspection" model="ir.actions.act_window">
        <field name="name">Vehicle Inspections</field>
        <field name="res_model">vehicle.inspection</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_vehicle_dashboard" model="ir.actions.act_window">
        <field name="name">Vehicle Dashboard</field>
        <field name="res_model">vehicle.vehicle</field>
        <field name="view_mode">graph,pivot,kanban,list</field>
        <field name="context">{
            'search_default_available': 1,
            }
        </field>
    </record>

    <record id="action_sales_dashboard" model="ir.actions.act_window">
        <field name="name">Sales Dashboard</field>
        <field name="res_model">vehicle.sale</field>
        <field name="view_mode">graph,pivot,list,form</field>
        <field name="context">{
            'search_default_this_month': 1,
            }
        </field>
    </record>

    <!-- Smart Button Actions -->
    <record id="action_vehicle_from_brand" model="ir.actions.act_window">
        <field name="name">Vehicles</field>
        <field name="res_model">vehicle.vehicle</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{
            'search_default_brand_id': active_id,
            'default_brand_id': active_id,
            }
        </field>
    </record>

    <record id="action_model_from_brand" model="ir.actions.act_window">
        <field name="name">Models</field>
        <field name="res_model">vehicle.model</field>
        <field name="view_mode">list,form</field>
        <field name="context">{
            'search_default_brand_id': active_id,
            'default_brand_id': active_id,
            }
        </field>
    </record>
</odoo>