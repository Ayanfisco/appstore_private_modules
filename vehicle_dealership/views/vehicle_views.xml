<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_vehicle_list" model="ir.ui.view">
        <field name="name">vehicle.vehicle.list</field>
        <field name="model">vehicle.vehicle</field>
        <field name="arch" type="xml">
            <list string="Vehicles" sample="1">
                <field name="name"/>
                <field name="brand_id"/>
                <field name="model_id"/>
                <field name="year"/>
                <field name="vin"/>
                <field name="condition"/>
                <field name="mileage"/>
                <field name="lot_id"/>
                <field name="selling_price" widget="monetary"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'available'"
                       decoration-info="state == 'reserved'"
                       decoration-muted="state == 'sold'"
                       decoration-warning="state == 'in_service'"/>
                <field name="days_in_inventory"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Vehicle Form View -->
    <record id="view_vehicle_form" model="ir.ui.view">
        <field name="name">vehicle.vehicle.form</field>
        <field name="model">vehicle.vehicle</field>
        <field name="arch" type="xml">
            <form string="Vehicle">
                <header>
                    <button name="action_reserve" type="object" string="Reserve"
                            invisible="state != 'available'" class="btn-primary"/>
                    <button name="action_make_available" type="object" string="Make Available"
                            invisible="state not in ['reserved', 'in_service']" class="btn-primary"/>
                    <button name="action_mark_sold" type="object" string="Mark as Sold"
                            invisible="state != 'reserved'" class="btn-success"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="available,reserved,sold"/>
                </header>
                <sheet>
                    <field name="image_1920" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                        <h2>
                            <field name="brand_id" placeholder="Brand" required="1"/>
                            <field name="model_id" placeholder="Model" required="1"/>
                        </h2>
                    </div>
                    <group>
                        <group string="Basic Information">
                            <field name="year"/>
                            <field name="vin"/>
                            <field name="license_plate"/>
                            <field name="condition"/>
                            <field name="mileage"/>
                        </group>
                        <group string="Pricing">
                            <field name="purchase_price" widget="monetary"/>
                            <field name="selling_price" widget="monetary"/>
                            <field name="profit_margin" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Technical Details">
                            <field name="body_type"/>
                            <field name="fuel_type"/>
                            <field name="transmission"/>
                            <field name="engine_number"/>
                            <field name="doors"/>
                        </group>
                        <group string="Colors">
                            <field name="color_exterior"/>
                            <field name="color_interior"/>
                        </group>
                    </group>
                    <group>
                        <group string="Dates">
                            <field name="purchase_date"/>
                            <field name="arrival_date"/>
                            <field name="registration_date"/>
                            <field name="registration_expiry_date"/>
                            <field name="warranty_expiry_date" readonly="1"/>
                            <field name="days_in_inventory"/>
                        </group>
                        <group string="Relations">
                            <field name="supplier_id"/>
                            <field name="location_id"/>
                            <field name="lot_id"/>
                            <field name="sale_id" readonly="1"/>
                            <field name="purchase_id" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Features &amp; Notes">
                            <group>
                                <field name="features" placeholder="List all vehicle features..."/>
                                <field name="notes" placeholder="Additional notes..."/>
                            </group>
                        </page>
                        <page string="Service History">
                            <field name="service_ids" mode="list">
                                <list>
                                    <field name="name"/>
                                    <field name="service_date"/>
                                    <field name="service_type"/>
                                    <field name="total_cost" widget="monetary"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Inspections">
                            <field name="inspection_ids" mode="list">
                                <list>
                                    <field name="name"/>
                                    <field name="inspection_date"/>
                                    <field name="inspection_type"/>
                                    <field name="overall_rating"/>
                                    <field name="passed" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>
                        <page string="Additional Images">
                            <field name="image_ids" mode="kanban"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Vehicle Kanban View -->
    <record id="view_vehicle_kanban" model="ir.ui.view">
        <field name="name">vehicle.vehicle.kanban</field>
        <field name="model">vehicle.vehicle</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" sample="1">
                <field name="id"/>
                <field name="name"/>
                <field name="brand_id"/>
                <field name="model_id"/>
                <field name="year"/>
                <field name="selling_price"/>
                <field name="state"/>
                <field name="lot_id"/>
                <field name="image_128"/>
                <templates>
                    <t t-name="card">
                        <div class="o_kanban_image">
                            <img t-att-src="record.image_128.raw_value ? 'data:image/png;base64,' + record.image_128.raw_value : '/web/static/img/placeholder.png'"
                                 alt="Vehicle" class="o_image_64_cover"/>
                        </div>
                        <div class="oe_kanban_details">
                            <strong class="o_kanban_record_title">
                                <field name="name"/>
                            </strong>
                            <div>
                                <field name="brand_id"/>
                                <field name="model_id"/>
                            </div>
                            <div>Year:
                                <field name="year"/>
                            </div>
                            <div>
                                <field name="selling_price" widget="monetary"/>
                            </div>
                            <div t-if="record.lot_id.raw_value">
                                <field name="lot_id"/>
                            </div>
                            <div>
                                <field name="state" widget="badge"
                                       decoration-success="state == 'available'"
                                       decoration-info="state == 'reserved'"
                                       decoration-muted="state == 'sold'"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Vehicle Search View -->
    <record id="view_vehicle_search" model="ir.ui.view">
        <field name="name">vehicle.vehicle.search</field>
        <field name="model">vehicle.vehicle</field>
        <field name="arch" type="xml">
            <search string="Search Vehicles">
                <field name="name" string="Vehicle"
                       filter_domain="['|', '|', ('name', 'ilike', self), ('vin', 'ilike', self), ('license_plate', 'ilike', self)]"/>
                <field name="brand_id"/>
                <field name="model_id"/>
                <field name="year"/>
                <field name="lot_id"/>
                <filter string="Available" name="available" domain="[('state', '=', 'available')]"/>
                <filter string="Reserved" name="reserved" domain="[('state', '=', 'reserved')]"/>
                <filter string="Sold" name="sold" domain="[('state', '=', 'sold')]"/>
                <separator/>
                <filter string="New" name="new" domain="[('condition', '=', 'new')]"/>
                <filter string="Used" name="used" domain="[('condition', '=', 'used')]"/>
                <separator/>
                <filter string="In Inventory &gt; 30 days" name="old_inventory"
                        domain="[('days_in_inventory', '&gt;', 30)]"/>
                <group expand="0" string="Group By">
                    <filter string="Brand" name="group_brand" context="{'group_by': 'brand_id'}"/>
                    <filter string="Model" name="group_model" context="{'group_by': 'model_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Condition" name="group_condition" context="{'group_by': 'condition'}"/>
                    <filter string="Year" name="group_year" context="{'group_by': 'year'}"/>
                    <filter string="Lot/Showroom" name="group_lot" context="{'group_by': 'lot_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="view_vehicle_pivot" model="ir.ui.view">
        <field name="name">vehicle.vehicle.pivot</field>
        <field name="model">vehicle.vehicle</field>
        <field name="arch" type="xml">
            <pivot string="Vehicle Inventory Analysis" sample="1">
                <field name="brand_id" type="row"/>
                <field name="state" type="col"/>
                <field name="selling_price" type="measure"/>
                <field name="profit_margin" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Vehicle Inventory Graph View -->
    <record id="view_vehicle_graph" model="ir.ui.view">
        <field name="name">vehicle.vehicle.graph</field>
        <field name="model">vehicle.vehicle</field>
        <field name="arch" type="xml">
            <graph string="Vehicle Statistics" type="bar" sample="1">
                <field name="brand_id"/>
                <field name="state"/>
            </graph>
        </field>
    </record>
    <record id="view_vehicle_form_buttons" model="ir.ui.view">
        <field name="name">vehicle.vehicle.form.buttons</field>
        <field name="model">vehicle.vehicle</field>
        <field name="inherit_id" ref="view_vehicle_form"/>
        <field name="arch" type="xml">
            <div class="oe_title" position="before">
                <div class="oe_button_box" name="button_box">
                    <button name="action_view_services" type="object"
                            class="oe_stat_button" icon="fa-wrench">
                        <field name="service_count" widget="statinfo" string="Services"/>
                    </button>
                    <button name="action_view_inspections" type="object"
                            class="oe_stat_button" icon="fa-search">
                        <field name="inspection_count" widget="statinfo" string="Inspections"/>
                    </button>
                    <button name="action_view_history" type="object"
                            class="oe_stat_button" icon="fa-history">
                        <field name="history_count" widget="statinfo" string="History"/>
                    </button>
                </div>
            </div>
        </field>
    </record>
    <record id="view_vehicle_search_extended" model="ir.ui.view">
        <field name="name">vehicle.vehicle.search.extended</field>
        <field name="model">vehicle.vehicle</field>
        <field name="inherit_id" ref="view_vehicle_search"/>
        <field name="arch" type="xml">
            <filter name="old_inventory" position="after">
                <separator/>
                <filter string="High Profit Margin" name="high_profit"
                        domain="[('profit_margin', '&gt;', 5000)]"/>
                <filter string="Low Mileage" name="low_mileage"
                        domain="[('mileage', '&lt;', 50000)]"/>
                <filter string="Needs Service" name="needs_service"
                        domain="[('state', '=', 'in_service')]"/>
                <separator/>
                <filter string="Registration Expiring Soon" name="registration_expiring"
                        domain="[('registration_expiry_date', '&lt;=',
                                 (context_today() + relativedelta(days=30)).strftime('%Y-%m-%d')),
                                 ('registration_expiry_date', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
            </filter>
        </field>
    </record>
</odoo>