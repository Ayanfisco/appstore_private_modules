<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_vehicle_mass_update_wizard_form" model="ir.ui.view">
        <field name="name">vehicle.mass.update.wizard.form</field>
        <field name="model">vehicle.mass.update.wizard</field>
        <field name="arch" type="xml">
            <form string="Mass Update Vehicles">
                <sheet>
                    <group>
                        <group>
                            <field name="vehicle_ids" invisible="1"/>
                            <field name="update_location"/>
                            <field name="location_id" invisible="not update_location"/>
                        </group>
                        <group>
                            <field name="update_state"/>
                            <field name="state" invisible="not update_state"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="update_selling_price"/>
                            <field name="selling_price" invisible="not update_selling_price"/>
                        </group>
                        <group>
                            <field name="apply_discount"/>
                            <field name="discount_percentage" invisible="not apply_discount"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button string="Apply" name="action_apply" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_vehicle_mass_update_wizard" model="ir.actions.act_window">
        <field name="name">Mass Update</field>
        <field name="res_model">vehicle.mass.update.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_vehicle_vehicle"/>
        <field name="binding_view_types">list</field>
    </record>

</odoo>