<odoo>
    <template id="report_vehicle_inspection_document">
        <t t-call="web.external_layout">
            <main>
                <t t-foreach="docs" t-as="doc">
                    <div class="page">
                        <h2>Vehicle Inspection Report</h2>

                        <div class="row mt32 mb32">
                            <div class="col-6">
                                <strong>Inspection Number:</strong>
                                <p t-field="doc.name"/>
                                <strong>Inspection Date:</strong>
                                <p t-field="doc.inspection_date"/>
                                <strong>Inspector:</strong>
                                <p t-field="doc.inspector_id.name"/>
                            </div>
                            <div class="col-6">
                                <strong>Vehicle:</strong>
                                <p>
                                    <span t-field="doc.vehicle_id.brand_id.name"/>
                                    <span t-field="doc.vehicle_id.model_id.name"/>
                                </p>
                                <strong>VIN:</strong>
                                <p t-field="doc.vehicle_id.vin"/>
                                <strong>Year:</strong>
                                <p t-field="doc.vehicle_id.year"/>
                            </div>
                        </div>

                        <h3>Inspection Results</h3>
                        <table class="table table-bordered">
                            <thead>
                                <tr>
                                    <th>Component</th>
                                    <th>Condition</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>Exterior</td>
                                    <td>
                                        <span t-field="doc.exterior_condition"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td>Interior</td>
                                    <td>
                                        <span t-field="doc.interior_condition"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td>Engine</td>
                                    <td>
                                        <span t-field="doc.engine_condition"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td>Transmission</td>
                                    <td>
                                        <span t-field="doc.transmission_condition"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td>Tires</td>
                                    <td>
                                        <span t-field="doc.tire_condition"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td>Brakes</td>
                                    <td>
                                        <span t-field="doc.brake_condition"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <div class="row">
                            <div class="col-6">
                                <strong>Overall Rating:</strong>
                                <p>
                                    <span t-field="doc.overall_rating"/>
                                    / 10
                                </p>
                            </div>
                            <div class="col-6">
                                <strong>Status:</strong>
                                <p>
                                    <t t-if="doc.passed">
                                        <span class="badge badge-success">PASSED</span>
                                    </t>
                                    <t t-else="">
                                        <span class="badge badge-danger">FAILED</span>
                                    </t>
                                </p>
                            </div>
                        </div>

                        <div t-if="doc.issues_found" class="mt32">
                            <h3>Issues Found</h3>
                            <p t-field="doc.issues_found"/>
                        </div>

                        <div t-if="doc.recommendations" class="mt32">
                            <h3>Recommendations</h3>
                            <p t-field="doc.recommendations"/>
                        </div>

                        <div t-if="doc.estimated_repair_cost" class="mt32">
                            <h3>Estimated Repair Cost</h3>
                            <p>
                                <span t-field="doc.estimated_repair_cost"
                                      t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                            </p>
                        </div>
                    </div>
                </t>
            </main>
        </t>
    </template>

    <record id="action_report_vehicle_inspection" model="ir.actions.report">
        <field name="name">Inspection Report</field>
        <field name="model">vehicle.inspection</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">vehicle_dealership.report_vehicle_inspection_document</field>
        <field name="report_file">vehicle_dealership.report_vehicle_inspection_document</field>
        <field name="binding_model_id" ref="model_vehicle_inspection"/>
        <field name="binding_type">report</field>
    </record>
</odoo>