<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sale Report Template -->
    <template id="report_vehicle_sale_document">

        <t t-call="web.external_layout">
            <main>

                <!-- LOOP OVER DOCS -->
                <t t-foreach="docs" t-as="doc">

                    <!-- Language context (NOW doc exists) -->
                    <t t-set="doc" t-value="doc.with_context(lang=doc.customer_id.lang)"/>

                    <div class="page">
                        <div class="oe_structure"/>

                        <h2>Vehicle Sale Order</h2>

                        <div class="row mt32 mb32">
                            <div class="col-auto col-3 mw-100 mb-2" t-if="doc.name">
                                <strong>Order Number:</strong>
                                <p class="m-0">
                                    <span t-field="doc.name"/>
                                </p>
                            </div>

                            <div class="col-auto col-3 mw-100 mb-2" t-if="doc.sale_date">
                                <strong>Sale Date:</strong>
                                <p class="m-0">
                                    <span t-field="doc.sale_date"/>
                                </p>
                            </div>

                            <div class="col-auto col-3 mw-100 mb-2" t-if="doc.delivery_date">
                                <strong>Delivery Date:</strong>
                                <p class="m-0">
                                    <span t-field="doc.delivery_date"/>
                                </p>
                            </div>
                        </div>

                        <div class="row mt32 mb32">
                            <div class="col-6">
                                <strong>Customer:</strong>
                                <div t-field="doc.customer_id"
                                     t-options='{"widget": "contact", "fields": ["address", "name", "phone", "email"]}'/>
                            </div>

                            <div class="col-6">
                                <strong>Salesperson:</strong>
                                <p>
                                    <span t-field="doc.salesperson_id.name"/>
                                </p>
                            </div>
                        </div>

                        <h3>Vehicle Details</h3>
                        <table class="table table-sm">
                            <tbody>
                                <tr>
                                    <th>Vehicle</th>
                                    <td>
                                        <span t-field="doc.vehicle_id.brand_id.name"/>
                                        <span t-field="doc.vehicle_id.model_id.name"/>
                                        (<span t-field="doc.vehicle_id.year"/>)
                                    </td>
                                </tr>
                                <tr>
                                    <th>VIN</th>
                                    <td>
                                        <span t-field="doc.vehicle_id.vin"/>
                                    </td>
                                </tr>
                                <tr>
                                    <th>Color</th>
                                    <td>
                                        <span t-field="doc.vehicle_id.color_exterior"/>
                                    </td>
                                </tr>
                                <tr>
                                    <th>Mileage</th>
                                    <td>
                                        <span t-field="doc.vehicle_id.mileage"/>
                                        km
                                    </td>
                                </tr>
                                <tr>
                                    <th>Condition</th>
                                    <td>
                                        <span t-field="doc.vehicle_id.condition"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <h3>Pricing</h3>
                        <table class="table table-sm">
                            <tbody>
                                <tr>
                                    <th>List Price</th>
                                    <td class="text-right">
                                        <span t-field="doc.list_price"
                                              t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                    </td>
                                </tr>

                                <tr t-if="doc.discount_amount">
                                    <th>Discount</th>
                                    <td class="text-right">
                                        -
                                        <span t-field="doc.discount_amount"
                                              t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                    </td>
                                </tr>

                                <tr t-if="doc.trade_in_value">
                                    <th>Trade-in Value</th>
                                    <td class="text-right">
                                        -
                                        <span t-field="doc.trade_in_value"
                                              t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                    </td>
                                </tr>

                                <tr class="border-black">
                                    <th>
                                        <strong>Final Price</strong>
                                    </th>
                                    <td class="text-right">
                                        <strong>
                                            <span t-field="doc.final_price"
                                                  t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                        </strong>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <div t-if="doc.payment_method == 'finance'">
                            <h3>Financing Details</h3>
                            <table class="table table-sm">
                                <tbody>
                                    <tr>
                                        <th>Down Payment</th>
                                        <td class="text-right">
                                            <span t-field="doc.down_payment"
                                                  t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                        </td>
                                    </tr>

                                    <tr>
                                        <th>Loan Amount</th>
                                        <td class="text-right">
                                            <span t-field="doc.loan_amount"
                                                  t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                        </td>
                                    </tr>

                                    <tr>
                                        <th>Loan Term</th>
                                        <td class="text-right">
                                            <span t-field="doc.loan_term"/>
                                            months
                                        </td>
                                    </tr>

                                    <tr>
                                        <th>Interest Rate</th>
                                        <td class="text-right">
                                            <span t-field="doc.interest_rate"/>%
                                        </td>
                                    </tr>

                                    <tr>
                                        <th>Monthly Payment</th>
                                        <td class="text-right">
                                            <span t-field="doc.monthly_payment"
                                                  t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                        </td>
                                    </tr>

                                    <tr t-if="doc.finance_company">
                                        <th>Finance Company</th>
                                        <td class="text-right">
                                            <span t-field="doc.finance_company.name"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <div t-if="doc.notes" class="mt32">
                            <h3>Notes</h3>
                            <p>
                                <span t-field="doc.notes"/>
                            </p>
                        </div>

                        <div class="oe_structure"/>
                    </div>

                </t>
            </main>
        </t>
    </template>
</odoo>
