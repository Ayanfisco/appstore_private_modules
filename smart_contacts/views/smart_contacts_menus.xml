<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════════
         HIDE the original Contacts app menu to eliminate duplication
         Note: ir.actions.act_window has no 'active' field in Odoo 18.
         Hiding the top-level menu item is sufficient.
    ═══════════════════════════════════════════════════════════════════ -->
    <record id="contacts.menu_contacts" model="ir.ui.menu">
        <field name="active">False</field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════
         SMART CONTACTS — standalone replacement application
    ═══════════════════════════════════════════════════════════════════ -->
    <menuitem
        id="menu_smart_contacts_root"
        name="Contacts"
        sequence="5"
        web_icon="smart_contacts,static/src/img/icon.svg"
    />

    <!-- ALL CONTACTS first (sequence=5) -->
    <menuitem
        id="menu_sc_all"
        name="All Contacts"
        parent="menu_smart_contacts_root"
        action="action_all_contacts"
        sequence="5"
    />

    <menuitem
        id="menu_sc_customers"
        name="Customers"
        parent="menu_smart_contacts_root"
        action="action_customers"
        sequence="10"
    />

    <menuitem
        id="menu_sc_vendors"
        name="Vendors"
        parent="menu_smart_contacts_root"
        action="action_vendors"
        sequence="20"
    />

    <menuitem
        id="menu_sc_employees"
        name="Employees"
        parent="menu_smart_contacts_root"
        action="action_employee_contacts"
        sequence="30"
    />

    <menuitem
        id="menu_sc_partners"
        name="Business Partners"
        parent="menu_smart_contacts_root"
        action="action_business_partners"
        sequence="40"
    />

    <!-- ═══════════════════════════════════════════════════════════════
         SALES APP  –  Customers menu under Sales > Orders
    ═══════════════════════════════════════════════════════════════════ -->
    <menuitem
        id="menu_sale_customers_sc"
        name="Customers"
        parent="sale.sale_order_menu"
        action="action_sale_customers"
        sequence="25"
    />

    <!-- ═══════════════════════════════════════════════════════════════
         PURCHASE APP  –  Vendors menu under Purchase > Orders
    ═══════════════════════════════════════════════════════════════════ -->
    <menuitem
        id="menu_purchase_vendors_sc"
        name="Vendors"
        parent="purchase.menu_procurement_management"
        action="action_purchase_vendors"
        sequence="25"
    />

</odoo>
