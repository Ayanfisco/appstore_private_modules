    <!-- ═══════════════════════════════════════════════════════════════
         SALE ORDER FORM  —  Customer field: is_customer only
    ═══════════════════════════════════════════════════════════════════ -->
    <record id="view_sale_order_form_sc" model="ir.ui.view">
        <field name="name">sale.order.form.smart.contacts</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="domain">[('is_customer', '=', True)]</attribute>
            </xpath>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════
         PURCHASE ORDER FORM  —  Vendor field: is_vendor only
    ═══════════════════════════════════════════════════════════════════ -->
    <record id="view_purchase_order_form_sc" model="ir.ui.view">
        <field name="name">purchase.order.form.smart.contacts</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="domain">[('is_vendor', '=', True)]</attribute>
            </xpath>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════
         ACCOUNT MOVE — restrict partner by move_type
         out_invoice/out_refund/out_receipt  = customers only
         in_invoice/in_refund/in_receipt     = vendors only
    ═══════════════════════════════════════════════════════════════════ -->
    <record id="view_account_move_form_sc" model="ir.ui.view">
        <field name="name">account.move.form.smart.contacts</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="domain">[('is_customer', '=', True)] if move_type in ('out_invoice', 'out_refund', 'out_receipt') else [('is_vendor', '=', True)] if move_type in ('in_invoice', 'in_refund', 'in_receipt') else []</attribute>
            </xpath>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════
         ACCOUNT PAYMENT — inbound = customer, outbound = vendor
    ═══════════════════════════════════════════════════════════════════ -->
    <record id="view_account_payment_form_sc" model="ir.ui.view">
        <field name="name">account.payment.form.smart.contacts</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="domain">[('is_customer', '=', True)] if payment_type == 'inbound' else [('is_vendor', '=', True)] if payment_type == 'outbound' else []</attribute>
            </xpath>
        </field>
    </record>

</odoo>
