<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="payment_provider_form_flutterwave" model="ir.ui.view">
        <field name="name">payment.provider.form.flutterwave</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='provider_credentials']" position="after">
                <group name="flutterwave_credentials" invisible="code != 'flutterwave'">
                    <group>
                        <field name="flutterwave_public_key" password="True" placeholder="FLWPUBK-xxxxx"/>
                        <field name="flutterwave_secret_key" password="True" placeholder="FLWSECK-xxxxx"/>
                        <field name="flutterwave_encryption_key" password="True" placeholder="Optional"/>
                    </group>
                    <group>
                        <field name="flutterwave_webhook_secret" password="True"
                               placeholder="Webhook secret hash (optional)"/>
                        <field name="flutterwave_payment_methods"/>
                    </group>
                </group>

                <group name="flutterwave_split_config"
                       invisible="code != 'flutterwave'"
                       string="Split Payment Configuration">
                    <field name="flutterwave_split_payment"/>
                    <field name="flutterwave_split_id"
                           invisible="not flutterwave_split_payment"
                           placeholder="SPL_xxxxx"/>
                </group>

                <group name="flutterwave_info"
                       invisible="code != 'flutterwave'"
                       string="Integration Information">
                    <div class="alert alert-info mb-0" role="alert">
                        <h4 class="alert-heading">How to Configure Flutterwave</h4>
                        <ol>
                            <li>Log in to your <a href="https://dashboard.flutterwave.com" target="_blank">Flutterwave Dashboard</a></li>
                            <li>Go to <strong>Settings → API</strong></li>
                            <li>Copy your <strong>Public Key</strong> and <strong>Secret Key</strong></li>
                            <li>For test mode, use your test keys (sandbox)</li>
                            <li>For live mode, use your live keys and set provider state to <strong>Enabled</strong></li>
                        </ol>
                        <hr/>
                        <h5>Webhook Configuration (Recommended)</h5>
                        <p>Set up webhooks for real-time payment notifications:</p>
                        <ol>
                            <li>In Flutterwave Dashboard, go to <strong>Settings → Webhooks</strong></li>
                            <li>Add webhook URL: <code><field name="id" invisible="1"/><span class="text-monospace" t-out="object.get_base_url() + '/payment/flutterwave/webhook'"/></code></li>
                            <li>Copy the <strong>Secret Hash</strong> and paste it above</li>
                            <li>Enable webhook for <strong>charge.completed</strong> event</li>
                        </ol>
                        <hr/>
                        <h5>Supported Payment Methods</h5>
                        <ul>
                            <li><i class="fa fa-credit-card"/> Cards (Visa, Mastercard, Verve)</li>
                            <li><i class="fa fa-bank"/> Bank Transfer</li>
                            <li><i class="fa fa-mobile"/> USSD</li>
                            <li><i class="fa fa-mobile-phone"/> Mobile Money (MTN, Vodafone, Airtel, etc.)</li>
                        </ul>
                        <hr/>
                        <h5>Supported Currencies</h5>
                        <p>NGN, USD, EUR, GBP, GHS, KES, UGX, ZAR, TZS, XAF, XOF, RWF, ZMW, and more</p>
                        <hr/>
                        <p class="mb-0">
                            <strong>Need help?</strong> Visit
                            <a href="https://developer.flutterwave.com/docs" target="_blank">Flutterwave Documentation</a>
                        </p>
                    </div>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Transaction Form View -->
    <record id="payment_transaction_form_flutterwave" model="ir.ui.view">
        <field name="name">payment.transaction.form.flutterwave</field>
        <field name="model">payment.transaction</field>
        <field name="inherit_id" ref="payment.payment_transaction_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='provider_details']" position="after">
                <group name="flutterwave_details"
                       string="Flutterwave Details"
                       invisible="provider_code != 'flutterwave'">
                    <field name="flutterwave_transaction_id"/>
                    <field name="flutterwave_payment_reference"/>
                </group>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="action_flutterwave_verify"
                        type="object"
                        string="Verify with Flutterwave"
                        invisible="provider_code != 'flutterwave' or state == 'done'"
                        class="btn-primary"/>
            </xpath>
        </field>
    </record>

    <!-- Menu Items -->
    <menuitem id="menu_flutterwave_configuration"
              name="Flutterwave"
              parent="payment.payment_provider_menu"
              action="payment.action_payment_provider"
              groups="base.group_system"
              sequence="10"/>

</odoo>