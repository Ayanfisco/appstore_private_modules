<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_appraisal_template_form" model="ir.ui.view">
        <field name="name">appraisal.template.form</field>
        <field name="model">appraisal.template</field>
        <field name="arch" type="xml">
            <form string="Appraisal Template">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active"/>
                        <field name="description"/>
                    </group>
                    <group string="Competencies">
                        <field name="competency_ids" nolabel="1">
                            <list>
                                <field name="name"/>
                                <field name="category"/>
                                <field name="weightage"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_appraisal_template_list" model="ir.ui.view">
        <field name="name">appraisal.template.list</field>
        <field name="model">appraisal.template</field>
        <field name="arch" type="xml">
            <list string="Appraisal Templates">
                <field name="name"/>
                <field name="description"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_appraisal_template" model="ir.actions.act_window">
        <field name="name">Appraisal Templates</field>
        <field name="res_model">appraisal.template</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>