<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Extend Company Settings Form -->
    <record id="view_company_form_petty_cash" model="ir.ui.view">
        <field name="name">res.company.form.petty.cash</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Petty Cash" name="petty_cash">
                    <group>
                        <group string="Accounts Configuration">
                            <field name="petty_cash_account_id"/>
                            <field name="default_expense_account_id"/>
                            <field name="petty_cash_journal_id"/>
                        </group>
                    </group>
                    <group>
                        <div class="alert alert-info" role="alert">
                            <p><strong>Configuration Guide:</strong></p>
                            <ul>
                                <li><strong>Petty Cash Account:</strong> Select the cash account used for petty cash (e.g., "Petty Cash on Hand")</li>
                                <li><strong>Default Expense Account:</strong> Select the default expense account for petty cash requests</li>
                                <li><strong>Petty Cash Journal:</strong> Select the cash journal for recording petty cash transactions</li>
                            </ul>
                        </div>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

