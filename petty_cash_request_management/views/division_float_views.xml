<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree View -->
    <record id="view_division_float_tree" model="ir.ui.view">
        <field name="name">division.float.tree</field>
        <field name="model">division.float</field>
        <field name="arch" type="xml">
            <list create="false" delete="false">
                <field name="division_id"/>
                <field name="balance" sum="Total Float Balance"
                       decoration-danger="balance &lt; 0"
                       decoration-success="balance &gt; 0"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_division_float_form" model="ir.ui.view">
        <field name="name">division.float.form</field>
        <field name="model">division.float</field>
        <field name="arch" type="xml">
            <form create="false" delete="false">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_petty_cash_requests"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-money">
                            <field name="petty_cash_ids" widget="statinfo"
                                   string="Paid Requests"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="division_id" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                        </group>
                        <group>
                            <field name="balance" widget="monetary" readonly="1"
                                   decoration-danger="balance &lt; 0"
                                   decoration-success="balance &gt; 0"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Transaction History">
                            <field name="petty_cash_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="requester_id"/>
                                    <field name="amount"/>
                                    <field name="purpose"/>
                                    <field name="cfo_approved_date"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Statistics">
                            <group>
                                <group string="Summary">
                                    <field name="total_paid_requests" readonly="1"/>
                                    <field name="total_paid_amount" widget="monetary" readonly="1"/>
                                    <field name="average_request_amount" widget="monetary" readonly="1"/>
                                </group>
                                <group string="This Month">
                                    <field name="monthly_requests" readonly="1"/>
                                    <field name="monthly_amount" widget="monetary" readonly="1"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="view_division_float_kanban" model="ir.ui.view">
        <field name="name">division.float.kanban</field>
        <field name="model">division.float</field>
        <field name="arch" type="xml">
            <kanban create="false" delete="false">
                <field name="division_id"/>
                <field name="balance"/>
                <field name="company_id"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="division_id"/>
                                    </strong>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <div class="row">
                                    <div class="col-12">
                                        <span class="badge badge-pill"
                                              t-attf-class="badge-{{record.balance.raw_value &lt; 0 ? 'danger' : 'success'}}">
                                            Float Balance:
                                            <field name="balance" widget="monetary"/>
                                        </span>
                                    </div>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <field name="petty_cash_ids" widget="badge"/>
                                    <span>Transactions</span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Graph View for Analytics -->
    <record id="view_division_float_graph" model="ir.ui.view">
        <field name="name">division.float.graph</field>
        <field name="model">division.float</field>
        <field name="arch" type="xml">
            <graph string="Division Float Balance" type="bar">
                <field name="division_id"/>
                <field name="balance" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Pivot View for Analysis -->
    <record id="view_division_float_pivot" model="ir.ui.view">
        <field name="name">division.float.pivot</field>
        <field name="model">division.float</field>
        <field name="arch" type="xml">
            <pivot string="Division Float Analysis">
                <field name="division_id" type="row"/>
                <field name="balance" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_division_float_search" model="ir.ui.view">
        <field name="name">division.float.search</field>
        <field name="model">division.float</field>
        <field name="arch" type="xml">
            <search string="Division Float">
                <field name="division_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <separator/>
                <filter string="Negative Balance" name="negative_balance"
                        domain="[('balance', '&lt;', 0)]"/>
                <filter string="Positive Balance" name="positive_balance"
                        domain="[('balance', '&gt;', 0)]"/>
                <filter string="Zero Balance" name="zero_balance"
                        domain="[('balance', '=', 0)]"/>
                <separator/>
<!--                <group expand="0" string="Group By">-->
<!--                    <filter string="Division" name="group_division"-->
<!--                            context="{'group_by': 'division_id'}"/>-->
<!--                    <filter string="Company" name="group_company"-->
<!--                            context="{'group_by': 'company_id'}"-->
<!--                            groups="base.group_multi_company"/>-->
<!--                </group>-->
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_division_float" model="ir.actions.act_window">
        <field name="name">Division Float Balance</field>
        <field name="res_model">division.float</field>
        <field name="view_mode">kanban,list,form,graph,pivot</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Track division float balances
            </p>
            <p>
                Division float balances are automatically updated when petty cash requests are paid.
                Monitor which divisions have negative balances and track spending patterns.
            </p>
        </field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_division_float"
              name="Division Float"
              parent="menu_petty_cash_root"
              action="action_division_float"
              sequence="20"/>

    <!-- Dashboard Menu -->
    <menuitem id="menu_petty_cash_dashboard"
              name="Dashboard"
              parent="menu_petty_cash_root"
              sequence="5"/>

</odoo>