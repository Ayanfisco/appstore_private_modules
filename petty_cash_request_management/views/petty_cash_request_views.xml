<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Sequence for request numbers -->
    <record id="seq_petty_cash_request" model="ir.sequence">
        <field name="name">Petty Cash Request Sequence</field>
        <field name="code">petty.cash.request</field>
        <field name="prefix">PCR/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Tree View -->
    <record id="view_petty_cash_request_tree" model="ir.ui.view">
        <field name="name">petty.cash.request.tree</field>
        <field name="model">petty.cash.request</field>
        <field name="arch" type="xml">
            <list decoration-info="state=='draft'"
                  decoration-warning="state in ('division_approval', 'cfo_approval')"
                  decoration-success="state=='paid'">
                <field name="name"/>
                <field name="requester_id"/>
                <field name="division_id"/>
                <field name="amount" sum="Total Amount"/>
                <field name="purpose"/>
                <field name="state" widget="badge"
                       decoration-info="state=='draft'"
                       decoration-warning="state in ('division_approval', 'cfo_approval')"
                       decoration-success="state in ('approved', 'paid')"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_petty_cash_request_form" model="ir.ui.view">
        <field name="name">petty.cash.request.form</field>
        <field name="model">petty.cash.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" string="Submit" type="object"
                            class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_division_approve" string="Approve (Division)"
                            type="object" class="oe_highlight"
                            invisible="state != 'division_approval'"
                            groups="petty_cash_request_management.group_petty_cash_division_head"/>
                    <button name="action_cfo_approve" string="Approve (CFO)"
                            type="object" class="oe_highlight"
                            invisible="state != 'cfo_approval'"
                            groups="petty_cash_request_management.group_petty_cash_cfo"/>
                    <button name="action_process_payment" string="Process Payment"
                            type="object" class="oe_highlight"
                            invisible="state != 'payment_processing'"
                            groups="petty_cash_request_management.group_petty_cash_treasury"/>
                    <button name="action_reject" string="Reject" type="object"
                            invisible="state not in ('division_approval', 'cfo_approval')"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state not in ('draft', 'division_approval')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,division_approval,cfo_approval,approved,payment_processing,paid"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(account.action_move_journal_line)d"
                                type="action"
                                class="oe_stat_button"
                                icon="fa-book"
                                invisible="not journal_entry_id"
                                context="{'default_move_id': journal_entry_id}">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Journal Entry</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="requester_id" readonly="state != 'draft'"/>
                            <field name="division_id" readonly="state != 'draft'"/>
                            <field name="expense_budget_code" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="amount" readonly="state != 'draft'"
                                   widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="purpose" readonly="state != 'draft'"/>
                    </group>
                    <notebook>
                        <page string="Supporting Documents">
                            <field name="attachment_ids" widget="many2many_binary"
                                   readonly="state != 'draft'"/>
                        </page>
                        <page string="Approval Details">
                            <group>
                                <group>
                                    <field name="division_head_id"/>
                                    <field name="division_approved_date"/>
                                </group>
                                <group>
                                    <field name="cfo_id"/>
                                    <field name="cfo_approved_date"/>
                                </group>
                            </group>
                        </page>
                        <page string="Accounting"
                              invisible="state not in ('approved', 'payment_processing', 'paid')">
                            <group>
                                <field name="journal_entry_id"/>
                                <field name="payment_id"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_petty_cash_request" model="ir.actions.act_window">
        <field name="name">Petty Cash Requests</field>
        <field name="res_model">petty.cash.request</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_my_requests': 1}</field>
    </record>

    <!-- Menu Items -->
    <menuitem id="menu_petty_cash_root"
              name="Petty Cash"
              web_icon="petty_cash_request_management,static/description/icon.png"
              sequence="50"/>

    <menuitem id="menu_petty_cash_requests"
              name="Requests"
              parent="menu_petty_cash_root"
              action="action_petty_cash_request"
              sequence="10"/>

</odoo>