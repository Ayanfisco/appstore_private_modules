<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Security Groups -->
        <record id="group_petty_cash_user" model="res.groups">
            <field name="name">Petty Cash User</field>
            <field name="category_id" ref="base.module_category_accounting"/>
        </record>

        <record id="group_petty_cash_division_head" model="res.groups">
            <field name="name">Petty Cash Division Head</field>
            <field name="category_id" ref="base.module_category_accounting"/>
            <field name="implied_ids" eval="[(4, ref('group_petty_cash_user'))]"/>
        </record>

        <record id="group_petty_cash_cfo" model="res.groups">
            <field name="name">Petty Cash CFO</field>
            <field name="category_id" ref="base.module_category_accounting"/>
            <field name="implied_ids" eval="[(4, ref('group_petty_cash_division_head'))]"/>
        </record>

        <record id="group_petty_cash_treasury" model="res.groups">
            <field name="name">Petty Cash Treasury</field>
            <field name="category_id" ref="base.module_category_accounting"/>
        </record>

        <!-- Record Rules -->
        <record id="petty_cash_request_user_rule" model="ir.rule">
            <field name="name">Petty Cash: User can see own requests</field>
            <field name="model_id" ref="model_petty_cash_request"/>
            <field name="domain_force">[('requester_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_petty_cash_user'))]"/>
        </record>

        <record id="petty_cash_request_division_head_rule" model="ir.rule">
            <field name="name">Petty Cash: Division Head sees division requests</field>
            <field name="model_id" ref="model_petty_cash_request"/>
            <field name="domain_force">[('division_head_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_petty_cash_division_head'))]"/>
        </record>

        <record id="petty_cash_request_cfo_rule" model="ir.rule">
            <field name="name">Petty Cash: CFO sees all</field>
            <field name="model_id" ref="model_petty_cash_request"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_petty_cash_cfo'))]"/>
        </record>

    </data>
</odoo>