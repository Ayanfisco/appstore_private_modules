<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Cron Job: Send reminders for pending approvals -->
        <record id="ir_cron_petty_cash_reminders" model="ir.cron">
            <field name="name">Petty Cash: Send Approval Reminders</field>
            <field name="model_id" ref="model_petty_cash_request"/>
            <field name="state">code</field>
            <field name="code">model._send_approval_reminders()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active">True</field>
        </record>

        <!-- Email Template: Division Head Reminder -->
        <record id="email_template_division_reminder" model="mail.template">
            <field name="name">Petty Cash: Division Approval Reminder</field>
            <field name="model_id" ref="model_petty_cash_request"/>
            <field name="subject">REMINDER: Petty Cash Request ${object.name} - Pending Your Approval</field>
            <field name="email_to">${object.division_head_id.email}</field>
            <field name="body_html" type="html">
                <div>
                    <p>Dear ${object.division_head_id.name},</p>
                    <p>
                        <strong>Reminder:</strong>
                        The following petty cash request has been pending your approval for 24 hours:
                    </p>
                    <ul>
                        <li>
                            <strong>Reference:</strong>
                            ${object.name}
                        </li>
                        <li>
                            <strong>Requester:</strong>
                            ${object.requester_id.name}
                        </li>
                        <li>
                            <strong>Amount:</strong>
                            ${object.amount} ${object.currency_id.symbol}
                        </li>
                        <li>
                            <strong>Purpose:</strong>
                            ${object.purpose}
                        </li>
                        <li>
                            <strong>Submitted:</strong>
                            ${object.create_date}
                        </li>
                    </ul>
                    <p>Please review and take action in Odoo as soon as possible.</p>
                    <p style="margin-top: 20px;">
                        <a href="/web#id=${object.id}&amp;model=petty.cash.request&amp;view_type=form"
                           style="background-color: #875A7B; padding: 10px 20px; color: white; text-decoration: none; border-radius: 5px;">
                            Review Request
                        </a>
                    </p>
                </div>
            </field>
        </record>

        <!-- Email Template: CFO Reminder -->
        <record id="email_template_cfo_reminder" model="mail.template">
            <field name="name">Petty Cash: CFO Approval Reminder</field>
            <field name="model_id" ref="model_petty_cash_request"/>
            <field name="subject">REMINDER: Petty Cash Request ${object.name} - Pending Final Approval</field>
            <field name="email_to">${object.cfo_id.email}</field>
            <field name="body_html" type="html">
                <div>
                    <p>Dear ${object.cfo_id.name},</p>
                    <p>
                        <strong>Reminder:</strong>
                        The following petty cash request has been pending your final approval for 24 hours:
                    </p>
                    <ul>
                        <li>
                            <strong>Reference:</strong>
                            ${object.name}
                        </li>
                        <li>
                            <strong>Requester:</strong>
                            ${object.requester_id.name}
                        </li>
                        <li>
                            <strong>Division:</strong>
                            ${object.division_id.name}
                        </li>
                        <li>
                            <strong>Amount:</strong>
                            ${object.amount} ${object.currency_id.symbol}
                        </li>
                        <li>
                            <strong>Division Approved:</strong>
                            ${object.division_approved_date}
                        </li>
                    </ul>
                    <p>Please review and provide final approval.</p>
                    <p style="margin-top: 20px;">
                        <a href="/web#id=${object.id}&amp;model=petty.cash.request&amp;view_type=form"
                           style="background-color: #875A7B; padding: 10px 20px; color: white; text-decoration: none; border-radius: 5px;">
                            Review Request
                        </a>
                    </p>
                </div>
            </field>
        </record>

        <!-- Email Template: Payment Processing Reminder -->
        <record id="email_template_payment_reminder" model="mail.template">
            <field name="name">Petty Cash: Payment Processing Reminder</field>
            <field name="model_id" ref="model_petty_cash_request"/>
            <field name="subject">Petty Cash Request ${object.name} - Payment Processing Required</field>
            <field name="body_html" type="html">
                <div>
                    <p>Dear Treasury Team,</p>
                    <p>The following petty cash request has been approved and requires payment processing:</p>
                    <ul>
                        <li>
                            <strong>Reference:</strong>
                            ${object.name}
                        </li>
                        <li>
                            <strong>Requester:</strong>
                            ${object.requester_id.name}
                        </li>
                        <li>
                            <strong>Division:</strong>
                            ${object.division_id.name}
                        </li>
                        <li>
                            <strong>Amount:</strong>
                            ${object.amount} ${object.currency_id.symbol}
                        </li>
                        <li>
                            <strong>Approved:</strong>
                            ${object.cfo_approved_date}
                        </li>
                    </ul>
                    <p>
                        <t t-if="object.amount &lt; 10000">
                            <strong>Note:</strong>
                            This request is below ₦10,000 - Treasury Officer can process.
                        </t>
                        <t t-else="">
                            <strong>Note:</strong>
                            This request is ₦10,000 or above - Payable Officer should process.
                        </t>
                    </p>
                    <p style="margin-top: 20px;">
                        <a href="/web#id=${object.id}&amp;model=petty.cash.request&amp;view_type=form"
                           style="background-color: #875A7B; padding: 10px 20px; color: white; text-decoration: none; border-radius: 5px;">
                            Process Payment
                        </a>
                    </p>
                </div>
            </field>
        </record>

    </data>
</odoo>