<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Division Head Notification -->
        <record id="email_template_division_approval" model="mail.template">
            <field name="name">Petty Cash: Division Approval Required</field>
            <field name="model_id" ref="model_petty_cash_request"/>
            <field name="subject">Petty Cash Request ${object.name} - Approval Required</field>
            <field name="email_to">${object.division_head_id.email}</field>
            <field name="body_html" type="html">
                <p>Dear ${object.division_head_id.name},</p>
                <p>A new petty cash request requires your approval:</p>
                <ul>
                    <li>Reference: ${object.name}</li>
                    <li>Requester: ${object.requester_id.name}</li>
                    <li>Amount: ${object.amount} ${object.currency_id.symbol}</li>
                    <li>Purpose: ${object.purpose}</li>
                </ul>
                <p>Please review and approve in Odoo.</p>
            </field>
        </record>

        <!-- CFO Notification -->
        <record id="email_template_cfo_approval" model="mail.template">
            <field name="name">Petty Cash: CFO Approval Required</field>
            <field name="model_id" ref="model_petty_cash_request"/>
            <field name="subject">Petty Cash Request ${object.name} - Final Approval Required</field>
            <field name="email_to">${object.cfo_id.email}</field>
            <field name="body_html" type="html">
                <p>Dear ${object.cfo_id.name},</p>
                <p>A petty cash request has been approved by the Division Head and requires your final approval:</p>
                <ul>
                    <li>Reference: ${object.name}</li>
                    <li>Requester: ${object.requester_id.name}</li>
                    <li>Division: ${object.division_id.name}</li>
                    <li>Amount: ${object.amount} ${object.currency_id.symbol}</li>
                </ul>
            </field>
        </record>

        <!-- Approval Notification -->
        <record id="email_template_approved" model="mail.template">
            <field name="name">Petty Cash: Request Approved</field>
            <field name="model_id" ref="model_petty_cash_request"/>
            <field name="subject">Petty Cash Request ${object.name} - Approved</field>
            <field name="email_to">${object.requester_id.email}</field>
            <field name="body_html" type="html">
                <p>Dear ${object.requester_id.name},</p>
                <p>Your petty cash request ${object.name} has been approved and posted to accounting.</p>
                <p>Amount: ${object.amount} ${object.currency_id.symbol}</p>
                <p>Payment processing will begin shortly.</p>
            </field>
        </record>

        <!-- Rejection Notification -->
        <record id="email_template_rejected" model="mail.template">
            <field name="name">Petty Cash: Request Rejected</field>
            <field name="model_id" ref="model_petty_cash_request"/>
            <field name="subject">Petty Cash Request ${object.name} - Rejected</field>
            <field name="email_to">${object.requester_id.email}</field>
            <field name="body_html" type="html">
                <p>Dear ${object.requester_id.name},</p>
                <p>Your petty cash request ${object.name} has been rejected.</p>
                <p>Please contact your supervisor for more information.</p>
            </field>
        </record>

    </data>
</odoo>