<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Reservation Confirmation Email -->
        <record id="email_template_reservation_confirmation" model="mail.template">
            <field name="name">Hotel: Reservation Confirmation</field>
            <field name="model_id" ref="model_hotel_reservation"/>
            <field name="subject">Reservation Confirmation - {{ object.name }}</field>
            <field name="email_from">{{ (object.company_id.email or user.email) }}</field>
            <field name="email_to">{{ object.guest_email }}</field>
            <field name="body_html" type="html">
                <div style="font-family: Arial, sans-serif; padding: 20px;">
                    <h2>Reservation Confirmation</h2>
                    <p>Dear {{ object.guest_id.name }},</p>
                    <p>Your reservation has been confirmed!</p>

                    <h3>Reservation Details:</h3>
                    <ul>
                        <li><strong>Reservation Number:</strong> {{ object.name }}</li>
                        <li><strong>Property:</strong> {{ object.property_id.name }}</li>
                        <li><strong>Room Type:</strong> {{ object.room_type_id.name }}</li>
                        <li><strong>Check-in:</strong> {{ format_date(object.check_in) }}</li>
                        <li><strong>Check-out:</strong> {{ format_date(object.check_out) }}</li>
                        <li><strong>Nights:</strong> {{ object.nights }}</li>
                        <li><strong>Guests:</strong> {{ object.adults }} Adult(s), {{ object.children }} Child(ren)</li>
                        <li><strong>Total Amount:</strong> {{ format_amount(object.total_amount, object.currency_id) }}</li>
                    </ul>

                    <p>We look forward to welcoming you!</p>

                    <p>Best regards,<br/>
                    {{ object.property_id.name }}</p>
                </div>
            </field>
        </record>
    </data>
</odoo>