<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Default Amenities -->
        <record id="amenity_wifi" model="hotel.amenity">
            <field name="name">WiFi</field>
            <field name="icon">fa-wifi</field>
        </record>
        <record id="amenity_tv" model="hotel.amenity">
            <field name="name">TV</field>
            <field name="icon">fa-television</field>
        </record>
        <record id="amenity_ac" model="hotel.amenity">
            <field name="name">Air Conditioning</field>
            <field name="icon">fa-snowflake-o</field>
        </record>
        <record id="amenity_minibar" model="hotel.amenity">
            <field name="name">Mini Bar</field>
            <field name="icon">fa-glass</field>
        </record>
        <record id="amenity_safe" model="hotel.amenity">
            <field name="name">Safe</field>
            <field name="icon">fa-lock</field>
        </record>

        <!-- Default Services -->
        <record id="service_breakfast" model="hotel.service">
            <field name="name">Breakfast</field>
            <field name="category">restaurant</field>
            <field name="price">15.00</field>
        </record>
        <record id="service_laundry" model="hotel.service">
            <field name="name">Laundry Service</field>
            <field name="category">laundry</field>
            <field name="price">10.00</field>
        </record>
        <record id="service_airport_pickup" model="hotel.service">
            <field name="name">Airport Pickup</field>
            <field name="category">transport</field>
            <field name="price">50.00</field>
        </record>
    </data>
</odoo>