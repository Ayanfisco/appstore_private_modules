<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_hotel_property" model="ir.sequence">
        <field name="name">Hotel Property</field>
        <field name="code">hotel.property</field>
        <field name="prefix">PROP</field>
        <field name="padding">4</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
    </record>

    <record id="seq_hotel_reservation" model="ir.sequence">
        <field name="name">Hotel Reservation</field>
        <field name="code">hotel.reservation</field>
        <field name="prefix">RES</field>
        <field name="padding">5</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
    </record>

    <record id="seq_hotel_housekeeping" model="ir.sequence">
        <field name="name">Hotel Housekeeping</field>
        <field name="code">hotel.housekeeping</field>
        <field name="prefix">HK</field>
        <field name="padding">5</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
    </record>
</odoo>