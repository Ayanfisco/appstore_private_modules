<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hotel_housekeeping_list" model="ir.ui.view">
        <field name="name">hotel.housekeeping.list</field>
        <field name="model">hotel.housekeeping</field>
        <field name="arch" type="xml">
            <list string="Housekeeping Tasks" decoration-info="state == 'pending'" decoration-warning="state == 'in_progress'" decoration-success="state == 'completed'">
                <field name="name"/>
                <field name="room_id"/>
                <field name="date"/>
                <field name="task_type"/>
                <field name="assigned_to"/>
                <field name="priority" widget="priority"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_hotel_housekeeping_form" model="ir.ui.view">
        <field name="name">hotel.housekeeping.form</field>
        <field name="model">hotel.housekeeping</field>
        <field name="arch" type="xml">
            <form string="Housekeeping Task">
                <header>
                    <button name="action_start" string="Start" type="object" class="oe_highlight" invisible="state != 'pending'"/>
                    <button name="action_complete" string="Complete" type="object" class="oe_highlight" invisible="state != 'in_progress'"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state in ['completed', 'cancelled']"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="room_id"/>
                            <field name="property_id"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="task_type"/>
                            <field name="assigned_to"/>
                            <field name="priority"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="start_time"/>
                            <field name="end_time"/>
                            <field name="duration"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_hotel_housekeeping_kanban" model="ir.ui.view">
        <field name="name">hotel.housekeeping.kanban</field>
        <field name="model">hotel.housekeeping</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="name"/>
                <field name="room_id"/>
                <field name="task_type"/>
                <field name="priority"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <strong><field name="room_id"/></strong>
                            </div>
                            <div class="o_kanban_record_body">
                                <field name="task_type"/>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <field name="assigned_to" widget="many2one_avatar_user"/>
                                <field name="priority" widget="priority"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_hotel_housekeeping" model="ir.actions.act_window">
        <field name="name">Housekeeping</field>
        <field name="res_model">hotel.housekeeping</field>
        <field name="view_mode">kanban,list,form</field>
    </record>
</odoo>