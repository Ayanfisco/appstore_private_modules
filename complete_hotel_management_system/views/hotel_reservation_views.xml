<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Reservation List View -->
    <record id="view_hotel_reservation_list" model="ir.ui.view">
        <field name="name">hotel.reservation.list</field>
        <field name="model">hotel.reservation</field>
        <field name="arch" type="xml">
            <list string="Reservations" decoration-info="state == 'draft'" decoration-success="state == 'confirmed'" decoration-warning="state == 'checked_in'" decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="guest_id"/>
                <field name="property_id"/>
                <field name="room_id"/>
                <field name="check_in"/>
                <field name="check_out"/>
                <field name="nights"/>
                <field name="total_amount" widget="monetary"/>
                <field name="invoice_status" optional="show"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'confirmed'" decoration-warning="state == 'checked_in'"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Reservation Form View -->
    <record id="view_hotel_reservation_form" model="ir.ui.view">
        <field name="name">hotel.reservation.form</field>
        <field name="model">hotel.reservation</field>
        <field name="arch" type="xml">
            <form string="Reservation">
                <header>
                    <button name="action_confirm" string="Confirm" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_check_in" string="Check In" type="object" class="oe_highlight" invisible="state != 'confirmed'"/>
                    <button name="action_check_out" string="Check Out" type="object" class="oe_highlight" invisible="state != 'checked_in'"/>
                    <button name="action_create_invoice" string="Create Invoice" type="object" class="btn-primary" invisible="state not in ['checked_out', 'done'] or invoice_status != 'not_invoiced'"/>
                    <button name="action_done" string="Mark as Done" type="object" invisible="state != 'checked_out'"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state in ['done', 'cancelled', 'checked_out']"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,checked_in,checked_out,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_create_invoice" type="object" class="oe_stat_button" icon="fa-pencil-square-o" invisible="invoice_id">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Create</span>
                                <span class="o_stat_text">Invoice</span>
                            </div>
                        </button>
                        <button name="%(account.action_move_out_invoice_type)d" type="action" class="oe_stat_button" icon="fa-pencil-square-o" invisible="not invoice_id" context="{'default_move_type': 'out_invoice'}">
                            <field name="invoice_status" widget="statinfo"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Cancelled" bg_color="text-bg-danger" invisible="state != 'cancelled'"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Guest Information">
                            <field name="guest_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="guest_email" widget="email"/>
                            <field name="guest_phone" widget="phone"/>
                            <field name="guest_mobile" widget="phone"/>
                        </group>
                        <group string="Booking Details">
                            <field name="booking_date"/>
                            <field name="source"/>
                            <field name="user_id" options="{'no_create': True}"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group>
                        <group string="Property &amp; Room">
                            <field name="property_id" options="{'no_create': True}"/>
                            <field name="room_type_id" options="{'no_create': True}"/>
                            <field name="room_id" options="{'no_create': True}"/>
                            <field name="room_rate"/>
                        </group>
                        <group string="Stay Details">
                            <field name="check_in"/>
                            <field name="check_out"/>
                            <field name="nights"/>
                            <field name="adults"/>
                            <field name="children"/>
                            <field name="total_guests"/>
                        </group>
                    </group>
                    <group string="Special Requests">
                        <field name="special_requests" nolabel="1" placeholder="Any special requests or preferences..."/>
                    </group>
                    <notebook>
                        <page string="Services">
                            <field name="service_line_ids">
                                <list editable="bottom">
                                    <field name="date"/>
                                    <field name="service_id"/>
                                    <field name="description"/>
                                    <field name="quantity"/>
                                    <field name="price_unit"/>
                                    <field name="price_subtotal"/>
                                    <field name="state"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Pricing">
                            <group>
                                <group string="Amount Breakdown">
                                    <field name="subtotal" widget="monetary"/>
                                    <field name="service_total" widget="monetary"/>
                                    <field name="tax_amount" widget="monetary"/>
                                    <field name="total_amount" widget="monetary" class="oe_subtotal_footer_separator"/>
                                    <field name="currency_id" invisible="1"/>
                                </group>
                            </group>
                        </page>
                        <page string="Check-in/Check-out">
                            <group>
                                <group>
                                    <field name="checkin_datetime" readonly="1"/>
                                    <field name="checkout_datetime" readonly="1"/>
                                </group>
                            </group>
                        </page>
                        <page string="Internal Notes">
                            <field name="internal_notes" placeholder="Internal notes for staff..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Reservation Calendar View -->
    <record id="view_hotel_reservation_calendar" model="ir.ui.view">
        <field name="name">hotel.reservation.calendar</field>
        <field name="model">hotel.reservation</field>
        <field name="arch" type="xml">
            <calendar string="Reservations" date_start="check_in" date_stop="check_out" color="state" mode="month">
                <field name="guest_id"/>
                <field name="room_id"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <!-- Reservation Kanban View -->
    <record id="view_hotel_reservation_kanban" model="ir.ui.view">
        <field name="name">hotel.reservation.kanban</field>
        <field name="model">hotel.reservation</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="name"/>
                <field name="guest_id"/>
                <field name="room_id"/>
                <field name="check_in"/>
                <field name="check_out"/>
                <field name="total_amount"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title"><field name="name"/></strong>
                                    <div class="o_kanban_record_subtitle">
                                        <field name="guest_id"/>
                                    </div>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <div><i class="fa fa-bed"/> <field name="room_id"/></div>
                                <div><i class="fa fa-calendar"/> <field name="check_in"/> - <field name="check_out"/></div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <field name="total_amount" widget="monetary"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Reservation Search View -->
    <record id="view_hotel_reservation_search" model="ir.ui.view">
        <field name="name">hotel.reservation.search</field>
        <field name="model">hotel.reservation</field>
        <field name="arch" type="xml">
            <search string="Search Reservations">
                <field name="name"/>
                <field name="guest_id"/>
                <field name="room_id"/>
                <field name="property_id"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="Checked In" name="checked_in" domain="[('state', '=', 'checked_in')]"/>
                <filter string="Check-ins Today" name="checkin_today" domain="[('check_in', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="Check-outs Today" name="checkout_today" domain="[('check_out', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter string="This Month" name="this_month" domain="[('check_in', '&gt;=', (context_today() - relativedelta(day=1)).strftime('%Y-%m-%d')), ('check_in', '&lt;=', (context_today() + relativedelta(day=31)).strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter string="Property" name="group_property" context="{'group_by': 'property_id'}"/>
                    <filter string="Guest" name="group_guest" context="{'group_by': 'guest_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Check-in Date" name="group_checkin" context="{'group_by': 'check_in'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Reservation Actions -->
    <record id="action_hotel_reservation" model="ir.actions.act_window">
        <field name="name">Reservations</field>
        <field name="res_model">hotel.reservation</field>
        <field name="view_mode">list,kanban,form,calendar</field>
        <field name="context">{'search_default_this_month': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first reservation
            </p>
            <p>
                Start managing your hotel bookings and reservations.
            </p>
        </field>
    </record>

    <record id="action_hotel_checkin_today" model="ir.actions.act_window">
        <field name="name">Check-ins Today</field>
        <field name="res_model">hotel.reservation</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('check_in', '=', context_today().strftime('%Y-%m-%d')), ('state', '=', 'confirmed')]</field>
        <field name="context">{'search_default_checkin_today': 1}</field>
    </record>

    <record id="action_hotel_checkout_today" model="ir.actions.act_window">
        <field name="name">Check-outs Today</field>
        <field name="res_model">hotel.reservation</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('check_out', '=', context_today().strftime('%Y-%m-%d')), ('state', '=', 'checked_in')]</field>
        <field name="context">{'search_default_checkout_today': 1}</field>
    </record>
</odoo>