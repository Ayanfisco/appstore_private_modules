<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hotel_room_type_list" model="ir.ui.view">
        <field name="name">hotel.room.type.list</field>
        <field name="model">hotel.room.type</field>
        <field name="arch" type="xml">
            <list string="Room Types">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="property_id"/>
                <field name="max_adults"/>
                <field name="max_children"/>
                <field name="list_price"/>
                <field name="room_count"/>
            </list>
        </field>
    </record>

    <record id="view_hotel_room_type_form" model="ir.ui.view">
        <field name="name">hotel.room.type.form</field>
        <field name="model">hotel.room.type</field>
        <field name="arch" type="xml">
            <form string="Room Type">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="property_id"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="list_price"/>
                            <field name="extra_bed_price"/>
                            <field name="size"/>
                        </group>
                    </group>
                    <group>
                        <group string="Capacity">
                            <field name="max_adults"/>
                            <field name="max_children"/>
                            <field name="max_capacity"/>
                        </group>
                    </group>
                    <group string="Amenities">
                        <field name="amenity_ids" widget="many2many_tags"/>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hotel_room_type" model="ir.actions.act_window">
        <field name="name">Room Types</field>
        <field name="res_model">hotel.room.type</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>