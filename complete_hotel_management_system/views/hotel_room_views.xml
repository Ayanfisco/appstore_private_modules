<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hotel_room_list" model="ir.ui.view">
        <field name="name">hotel.room.list</field>
        <field name="model">hotel.room</field>
        <field name="arch" type="xml">
            <list string="Rooms" decoration-success="state == 'available'" decoration-warning="state == 'occupied'" decoration-danger="state == 'maintenance'">
                <field name="room_number"/>
                <field name="property_id"/>
                <field name="room_type_id"/>
                <field name="floor"/>
                <field name="list_price"/>
                <field name="state" widget="badge"/>
                <field name="housekeeping_status"/>
            </list>
        </field>
    </record>

    <record id="view_hotel_room_form" model="ir.ui.view">
        <field name="name">hotel.room.form</field>
        <field name="model">hotel.room</field>
        <field name="arch" type="xml">
            <form string="Room">
                <header>
                    <button name="action_set_available" string="Set Available" type="object" class="btn-success" invisible="state == 'available'"/>
                    <button name="action_set_maintenance" string="Under Maintenance" type="object" invisible="state == 'maintenance'"/>
                    <button name="action_set_cleaning" string="Needs Cleaning" type="object"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="room_number"/>
                            <field name="property_id"/>
                            <field name="room_type_id"/>
                            <field name="floor"/>
                        </group>
                        <group>
                            <field name="list_price"/>
                            <field name="housekeeping_status"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_hotel_room_kanban" model="ir.ui.view">
        <field name="name">hotel.room.kanban</field>
        <field name="model">hotel.room</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="room_number"/>
                <field name="room_type_id"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <strong>Room <field name="room_number"/></strong>
                            </div>
                            <div class="o_kanban_record_body">
                                <field name="room_type_id"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_hotel_room" model="ir.actions.act_window">
        <field name="name">Rooms</field>
        <field name="res_model">hotel.room</field>
        <field name="view_mode">kanban,list,form</field>
    </record>
</odoo>