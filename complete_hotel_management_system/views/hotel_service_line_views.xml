<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hotel_service_line_list" model="ir.ui.view">
        <field name="name">hotel.service.line.list</field>
        <field name="model">hotel.service.line</field>
        <field name="arch" type="xml">
            <list string="Service Lines">
                <field name="date"/>
                <field name="reservation_id"/>
                <field name="service_id"/>
                <field name="quantity"/>
                <field name="price_unit"/>
                <field name="price_subtotal"/>
                <field name="state"/>
            </list>
        </field>
    </record>
</odoo>