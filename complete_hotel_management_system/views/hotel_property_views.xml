<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Property List View -->
    <record id="view_hotel_property_list" model="ir.ui.view">
        <field name="name">hotel.property.list</field>
        <field name="model">hotel.property</field>
        <field name="arch" type="xml">
            <list string="Hotel Properties">
                <field name="name"/>
                <field name="code"/>
                <field name="city"/>
                <field name="star_rating"/>
                <field name="room_count"/>
                <field name="available_room_count"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- Property Form View -->
    <record id="view_hotel_property_form" model="ir.ui.view">
        <field name="name">hotel.property.form</field>
        <field name="model">hotel.property</field>
        <field name="arch" type="xml">
            <form string="Hotel Property">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_rooms" type="object" class="oe_stat_button" icon="fa-bed">
                            <field name="room_count" widget="statinfo" string="Rooms"/>
                        </button>
                        <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                            <field name="active" widget="boolean_button" options="{'terminology': 'archive'}"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="name" placeholder="e.g., Grand Hotel"/>
                            <field name="code"/>
                            <field name="star_rating"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="phone" widget="phone"/>
                            <field name="mobile" widget="phone"/>
                            <field name="email" widget="email"/>
                            <field name="website" widget="url"/>
                        </group>
                    </group>
                    <group>
                        <group string="Address">
                            <field name="street" placeholder="Street..."/>
                            <field name="street2"/>
                            <field name="city"/>
                            <field name="state_id"/>
                            <field name="zip"/>
                            <field name="country_id"/>
                        </group>
                        <group string="Check-in/Check-out Policy">
                            <field name="check_in_time" widget="float_time"/>
                            <field name="check_out_time" widget="float_time"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Room Types">
                            <field name="room_type_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="max_adults"/>
                                    <field name="max_children"/>
                                    <field name="list_price"/>
                                    <field name="room_count"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Property Kanban View -->
    <record id="view_hotel_property_kanban" model="ir.ui.view">
        <field name="name">hotel.property.kanban</field>
        <field name="model">hotel.property</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="id"/>
                <field name="name"/>
                <field name="city"/>
                <field name="star_rating"/>
                <field name="room_count"/>
                <field name="available_room_count"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title"><field name="name"/></strong>
                                    <div class="o_kanban_record_subtitle">
                                        <field name="city"/> - <field name="star_rating"/>
                                    </div>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <field name="phone" widget="phone"/>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <span><i class="fa fa-bed"/> <field name="room_count"/> rooms</span>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <span class="badge text-bg-success"><field name="available_room_count"/> available</span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Property Action -->
    <record id="action_hotel_property" model="ir.actions.act_window">
        <field name="name">Hotel Properties</field>
        <field name="res_model">hotel.property</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first hotel property
            </p>
            <p>
                Define your hotel properties to start managing rooms and reservations.
            </p>
        </field>
    </record>
</odoo>