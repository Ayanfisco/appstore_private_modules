<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hotel_guest_list" model="ir.ui.view">
        <field name="name">hotel.guest.list</field>
        <field name="model">hotel.guest</field>
        <field name="arch" type="xml">
            <list string="Guests">
                <field name="name"/>
                <field name="email" widget="email"/>
                <field name="phone" widget="phone"/>
                <field name="nationality_id"/>
                <field name="reservation_count"/>
                <field name="vip" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_hotel_guest_form" model="ir.ui.view">
        <field name="name">hotel.guest.form</field>
        <field name="model">hotel.guest</field>
        <field name="arch" type="xml">
            <form string="Guest">
                <header>
                    <button name="action_view_reservations" string="View Reservations" type="object" class="oe_highlight" invisible="reservation_count == 0"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_reservations" type="object" class="oe_stat_button" icon="fa-calendar">
                            <field name="reservation_count" widget="statinfo" string="Reservations"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="VIP" bg_color="text-bg-warning" invisible="not vip"/>
                    <widget name="web_ribbon" title="Blacklisted" bg_color="text-bg-danger" invisible="not blacklisted"/>
                    <group>
                        <group string="Personal Information">
                            <field name="title"/>
                            <field name="name"/>
                            <field name="gender"/>
                            <field name="date_of_birth"/>
                            <field name="age"/>
                            <field name="nationality_id"/>
                        </group>
                        <group string="Contact Information">
                            <field name="email" widget="email"/>
                            <field name="phone" widget="phone"/>
                            <field name="mobile" widget="phone"/>
                        </group>
                    </group>
                    <group string="Address">
                        <group>
                            <field name="street"/>
                            <field name="street2"/>
                            <field name="city"/>
                        </group>
                        <group>
                            <field name="state_id"/>
                            <field name="zip"/>
                            <field name="country_id"/>
                        </group>
                    </group>
                    <group string="Identification">
                        <group>
                            <field name="id_type"/>
                            <field name="id_number"/>
                            <field name="id_expiry"/>
                        </group>
                    </group>
                    <group string="Guest Status">
                        <group>
                            <field name="vip"/>
                            <field name="blacklisted"/>
                            <field name="blacklist_reason" invisible="not blacklisted"/>
                        </group>
                        <group>
                            <field name="total_nights"/>
                            <field name="total_spent" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Special Requests">
                            <field name="special_requests" nolabel="1"/>
                        </page>
                        <page string="Internal Notes">
                            <field name="notes" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_hotel_guest" model="ir.actions.act_window">
        <field name="name">Guests</field>
        <field name="res_model">hotel.guest</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>