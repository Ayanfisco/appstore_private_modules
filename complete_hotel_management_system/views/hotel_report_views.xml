<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════════════
         REVENUE REPORT — Pivot, Graph, List
    ══════════════════════════════════════════════════════════════════ -->

    <record id="view_hotel_revenue_report_pivot" model="ir.ui.view">
        <field name="name">hotel.revenue.report.pivot</field>
        <field name="model">hotel.revenue.report</field>
        <field name="arch" type="xml">
            <pivot string="Revenue Report" disable_linking="True">
                <field name="month" type="row"/>
                <field name="room_type_id" type="row"/>
                <field name="source" type="col"/>
                <field name="room_revenue" type="measure"/>
                <field name="service_revenue" type="measure"/>
                <field name="total_revenue" type="measure"/>
                <field name="tax_amount" type="measure"/>
                <field name="total_amount" type="measure"/>
                <field name="nights" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_hotel_revenue_report_graph" model="ir.ui.view">
        <field name="name">hotel.revenue.report.graph</field>
        <field name="model">hotel.revenue.report</field>
        <field name="arch" type="xml">
            <graph string="Revenue Report" type="bar" stacked="True">
                <field name="month" type="row"/>
                <field name="total_revenue" type="measure"/>
                <field name="service_revenue" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_hotel_revenue_report_list" model="ir.ui.view">
        <field name="name">hotel.revenue.report.list</field>
        <field name="model">hotel.revenue.report</field>
        <field name="arch" type="xml">
            <list string="Revenue Report" create="false" edit="false" delete="false">
                <field name="name"/>
                <field name="month"/>
                <field name="property_id"/>
                <field name="room_type_id"/>
                <field name="source"/>
                <field name="state"/>
                <field name="check_in"/>
                <field name="check_out"/>
                <field name="nights"/>
                <field name="room_rate"/>
                <field name="room_revenue" sum="Room Revenue"/>
                <field name="service_revenue" sum="Service Revenue"/>
                <field name="total_revenue" sum="Total Revenue"/>
                <field name="tax_amount" sum="Tax"/>
                <field name="total_amount" sum="Grand Total"/>
                <field name="invoice_status"/>
            </list>
        </field>
    </record>

    <record id="view_hotel_revenue_report_search" model="ir.ui.view">
        <field name="name">hotel.revenue.report.search</field>
        <field name="model">hotel.revenue.report</field>
        <field name="arch" type="xml">
            <search string="Revenue Report">
                <field name="name" string="Reservation"/>
                <field name="property_id"/>
                <field name="room_type_id"/>
                <field name="guest_id"/>
                <field name="month"/>
                <separator/>
                <filter string="This Month" name="this_month"
                        domain="[('month', '=', context_today().strftime('%Y-%m'))]"/>
                <filter string="This Year" name="this_year"
                        domain="[('year', '=', context_today().strftime('%Y'))]"/>
                <filter string="Paid" name="paid"
                        domain="[('invoice_status', '=', 'paid')]"/>
                <filter string="Not Yet Invoiced" name="not_invoiced"
                        domain="[('invoice_status', '=', 'not_invoiced')]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Month" name="group_month" context="{'group_by': 'month'}"/>
                    <filter string="Year" name="group_year" context="{'group_by': 'year'}"/>
                    <filter string="Property" name="group_property" context="{'group_by': 'property_id'}"/>
                    <filter string="Room Type" name="group_room_type" context="{'group_by': 'room_type_id'}"/>
                    <filter string="Booking Source" name="group_source" context="{'group_by': 'source'}"/>
                    <filter string="Invoice Status" name="group_invoice" context="{'group_by': 'invoice_status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hotel_revenue_report" model="ir.actions.act_window">
        <field name="name">Revenue Report</field>
        <field name="res_model">hotel.revenue.report</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="context">{'search_default_this_month': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No revenue data yet.
            </p>
            <p>Confirmed reservations will appear here once they exist.</p>
        </field>
    </record>


    <!-- ══════════════════════════════════════════════════════════════
         OCCUPANCY REPORT — Pivot, Graph, List
    ══════════════════════════════════════════════════════════════════ -->

    <record id="view_hotel_occupancy_report_pivot" model="ir.ui.view">
        <field name="name">hotel.occupancy.report.pivot</field>
        <field name="model">hotel.occupancy.report</field>
        <field name="arch" type="xml">
            <pivot string="Occupancy Report" disable_linking="True">
                <field name="month" type="row"/>
                <field name="property_id" type="row"/>
                <field name="room_type_id" type="col"/>
                <field name="reservations" type="measure"/>
                <field name="room_nights_sold" type="measure"/>
                <field name="total_guests" type="measure"/>
                <field name="total_room_revenue" type="measure"/>
                <field name="avg_daily_rate" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_hotel_occupancy_report_graph" model="ir.ui.view">
        <field name="name">hotel.occupancy.report.graph</field>
        <field name="model">hotel.occupancy.report</field>
        <field name="arch" type="xml">
            <graph string="Occupancy Report" type="line">
                <field name="month" type="row"/>
                <field name="room_nights_sold" type="measure"/>
                <field name="avg_daily_rate" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_hotel_occupancy_report_list" model="ir.ui.view">
        <field name="name">hotel.occupancy.report.list</field>
        <field name="model">hotel.occupancy.report</field>
        <field name="arch" type="xml">
            <list string="Occupancy Report" create="false" edit="false" delete="false">
                <field name="month"/>
                <field name="property_id"/>
                <field name="room_type_id"/>
                <field name="reservations" sum="Reservations"/>
                <field name="room_nights_sold" sum="Room Nights Sold"/>
                <field name="total_guests" sum="Total Guests"/>
                <field name="total_room_revenue" sum="Room Revenue"/>
                <field name="avg_daily_rate" avg="ADR"/>
            </list>
        </field>
    </record>

    <record id="view_hotel_occupancy_report_search" model="ir.ui.view">
        <field name="name">hotel.occupancy.report.search</field>
        <field name="model">hotel.occupancy.report</field>
        <field name="arch" type="xml">
            <search string="Occupancy Report">
                <field name="property_id"/>
                <field name="room_type_id"/>
                <field name="month"/>
                <separator/>
                <filter string="This Month" name="this_month"
                        domain="[('month', '=', context_today().strftime('%Y-%m'))]"/>
                <filter string="This Year" name="this_year"
                        domain="[('year', '=', context_today().strftime('%Y'))]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Month" name="group_month" context="{'group_by': 'month'}"/>
                    <filter string="Year" name="group_year" context="{'group_by': 'year'}"/>
                    <filter string="Property" name="group_property" context="{'group_by': 'property_id'}"/>
                    <filter string="Room Type" name="group_room_type" context="{'group_by': 'room_type_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hotel_occupancy_report" model="ir.actions.act_window">
        <field name="name">Occupancy &amp; ADR Report</field>
        <field name="res_model">hotel.occupancy.report</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="context">{'search_default_this_year': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No occupancy data yet.
            </p>
            <p>Data appears here once reservations are confirmed.</p>
        </field>
    </record>

</odoo>
