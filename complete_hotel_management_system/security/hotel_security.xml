<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_complete_hotel_category" model="ir.module.category">
        <field name="name">Complete Hotel Management</field>
        <field name="description">User access rights for Complete Hotel Management System</field>
        <field name="sequence">20</field>
    </record>

    <!-- Hotel User -->
    <record id="group_hotel_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_complete_hotel_category"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Hotel Manager -->
    <record id="group_hotel_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_complete_hotel_category"/>
        <field name="implied_ids" eval="[(4, ref('group_hotel_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- Record Rules -->
    <record id="hotel_property_rule" model="ir.rule">
        <field name="name">Hotel Property: multi-company</field>
        <field name="model_id" ref="model_hotel_property"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="hotel_reservation_user_rule" model="ir.rule">
        <field name="name">Hotel Reservation: User can see all</field>
        <field name="model_id" ref="model_hotel_reservation"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_hotel_user'))]"/>
    </record>
</odoo>