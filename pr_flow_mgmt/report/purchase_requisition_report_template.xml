<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Report Action -->
    <record id="action_report_pr_flow_requisition" model="ir.actions.report">
        <field name="name">Purchase Requisition</field>
        <field name="model">pr.flow.requisition</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">pr_flow_mgmt.report_purchase_requisition_document</field>
        <field name="report_file">pr_flow_mgmt.report_purchase_requisition_document</field>
        <field name="binding_model_id" ref="model_pr_flow_requisition"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Report Template -->
    <template id="report_purchase_requisition_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="oe_structure"/>

                        <h2 class="mt-4">
                            <span>Purchase Requisition:</span>
                            <span t-field="o.name"/>
                        </h2>

                        <div id="informations" class="row mt-4 mb-4">
                            <div class="col-6">
                                <strong>Requested By:</strong>
                                <span t-field="o.user_id"/>
                                <br/>
                                <strong>Department:</strong>
                                <span t-field="o.department_id"/>
                                <br/>
                                <strong>Request Date:</strong>
                                <span t-field="o.date_request"/>
                                <br/>
                                <strong>Required Date:</strong>
                                <span t-field="o.date_required"/>
                                <br/>
                            </div>
                            <div class="col-6">
                                <strong>Status:</strong>
                                <span t-field="o.state"/>
                                <br/>
                                <strong>Priority:</strong>
                                <span t-field="o.priority"/>
                                <br/>
                                <t t-if="o.approved_by_id">
                                    <strong>Approved By:</strong>
                                    <span t-field="o.approved_by_id"/>
                                    <br/>
                                    <strong>Approved Date:</strong>
                                    <span t-field="o.date_approved"/>
                                    <br/>
                                </t>
                            </div>
                        </div>

                        <t t-if="o.description">
                            <div class="row mt-2 mb-2">
                                <div class="col-12">
                                    <strong>Description:</strong>
                                    <br/>
                                    <span t-field="o.description"/>
                                </div>
                            </div>
                        </t>

                        <table class="table table-sm o_main_table table-borderless">
                            <thead>
                                <tr>
                                    <th name="th_product" class="text-start">Product</th>
                                    <th name="th_description" class="text-start">Description</th>
                                    <th name="th_quantity" class="text-end">Quantity</th>
                                    <th name="th_uom" class="text-start">UoM</th>
                                    <th name="th_price" class="text-end">Est. Price</th>
                                    <th name="th_subtotal" class="text-end">Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="o.line_ids" t-as="line">
                                    <tr>
                                        <td name="td_product">
                                            <span t-field="line.product_id"/>
                                        </td>
                                        <td name="td_description">
                                            <span t-field="line.description"/>
                                        </td>
                                        <td name="td_quantity" class="text-end">
                                            <span t-field="line.quantity"/>
                                        </td>
                                        <td name="td_uom">
                                            <span t-field="line.uom_id"/>
                                        </td>
                                        <td name="td_price" class="text-end">
                                            <span t-field="line.estimated_price"
                                                  t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                        <td name="td_subtotal" class="text-end">
                                            <span t-field="line.subtotal"
                                                  t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <div class="clearfix">
                            <div id="total" class="row">
                                <div class="col-8"/>
                                <div class="col-4">
                                    <table class="table table-sm table-borderless">
                                        <tr class="border-black">
                                            <td>
                                                <strong>Total Estimated Amount</strong>
                                            </td>
                                            <td class="text-end">
                                                <span t-field="o.estimated_amount"
                                                      t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <t t-if="o.notes">
                            <div class="row mt-4">
                                <div class="col-12">
                                    <strong>Internal Notes:</strong>
                                    <br/>
                                    <span t-field="o.notes"/>
                                </div>
                            </div>
                        </t>

                        <div class="oe_structure"/>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>