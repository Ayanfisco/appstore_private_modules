<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Security Categories -->
        <record id="module_category_purchase_requisition" model="res.groups.privilege">
            <field name="name">Purchase Requisition</field>
            <field name="description">Manage purchase requisition access rights</field>
            <field name="sequence">10</field>
        </record>

        <!-- User Groups -->
        <record id="group_pr_user" model="res.groups">
            <field name="name">Requisition User</field>
            <field name="privilege_id" ref="module_category_purchase_requisition"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Can create and view own purchase requisitions</field>
        </record>

        <record id="group_pr_manager" model="res.groups">
            <field name="name">Requisition Manager</field>
            <field name="privilege_id" ref="module_category_purchase_requisition"/>
            <field name="implied_ids" eval="[(4, ref('group_pr_user'))]"/>
            <field name="comment">Can approve department level requisitions</field>
        </record>

        <record id="group_pr_director" model="res.groups">
            <field name="name">Requisition Director</field>
            <field name="privilege_id" ref="module_category_purchase_requisition"/>
            <field name="implied_ids" eval="[(4, ref('group_pr_manager'))]"/>
            <field name="comment">Can give final approval to requisitions</field>
        </record>

        <record id="group_pr_admin" model="res.groups">
            <field name="name">Requisition Administrator</field>
            <field name="privilege_id" ref="module_category_purchase_requisition"/>
            <field name="implied_ids" eval="[(4, ref('group_pr_director'))]"/>
            <field name="comment">Full access to all requisition features</field>
        </record>

        <!-- Record Rules -->
        <!-- Users can see their own requisitions and those from their department -->
        <record id="rule_pr_requisition_user" model="ir.rule">
            <field name="name">Purchase Requisition User Rule</field>
            <field name="model_id" ref="model_pr_flow_requisition"/>
            <field name="domain_force">[
                '|',
                ('user_id', '=', user.id),
                ('department_id.member_ids', 'in', [user.id])
            ]</field>
            <field name="groups" eval="[(4, ref('group_pr_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Managers can see all requisitions -->
        <record id="rule_pr_requisition_manager" model="ir.rule">
            <field name="name">Purchase Requisition Manager Rule</field>
            <field name="model_id" ref="model_pr_flow_requisition"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_pr_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Directors and Admins have full access -->
        <record id="rule_pr_requisition_director" model="ir.rule">
            <field name="name">Purchase Requisition Director Rule</field>
            <field name="model_id" ref="model_pr_flow_requisition"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_pr_director')), (4, ref('group_pr_admin'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Requisition Line Rules -->
        <record id="rule_pr_requisition_line_user" model="ir.rule">
            <field name="name">Purchase Requisition Line User Rule</field>
            <field name="model_id" ref="model_pr_flow_requisition_line"/>
            <field name="domain_force">[
                '|',
                ('requisition_id.user_id', '=', user.id),
                ('requisition_id.department_id.member_ids', 'in', [user.id])
            ]</field>
            <field name="groups" eval="[(4, ref('group_pr_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_pr_requisition_line_manager" model="ir.rule">
            <field name="name">Purchase Requisition Line Manager Rule</field>
            <field name="model_id" ref="model_pr_flow_requisition_line"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_pr_manager')), (4, ref('group_pr_director')), (4, ref('group_pr_admin'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

    </data>
</odoo>