<odoo>

    <record id="res_config_settings_view_form_inherit" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pr.flow</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <div class="app_settings_block" data-string="Purchase Requisition"
                     string="Purchase Requisition" data-key="pr_flow_mgmt"
                     groups="pr_flow_mgmt.group_pr_admin">
                    <h2>Purchase Requisition Settings</h2>

                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="pr_require_dept_approval"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="pr_require_dept_approval"/>
                                <div class="text-muted">
                                    Require department manager approval before requisitions can be processed
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="pr_require_manager_approval"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="pr_require_manager_approval"/>
                                <div class="text-muted">
                                    Require manager approval after department approval
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <label for="pr_auto_approve_threshold"/>
                                <div class="text-muted">
                                    Automatically approve requisitions below this amount (0 to disable)
                                </div>
                                <div class="content-group">
                                    <div class="row mt16">
                                        <label for="pr_auto_approve_threshold" class="col-lg-3 o_light_label"/>
                                        <field name="pr_auto_approve_threshold" class="oe_inline"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
