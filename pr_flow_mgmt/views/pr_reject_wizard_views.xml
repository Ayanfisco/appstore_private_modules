<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_pr_reject_wizard_form" model="ir.ui.view">
        <field name="name">pr.flow.reject.wizard.form</field>
        <field name="model">pr.flow.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Requisition">
                <sheet>
                    <group>
                        <field name="requisition_id" readonly="1"/>
                    </group>
                    <group>
                        <field name="rejection_reason" placeholder="Please provide a detailed reason for rejection..."
                               nolabel="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_reject" string="Reject" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>