<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Purchase Requisition Form View -->
    <record id="view_pr_flow_requisition_form" model="ir.ui.view">
        <field name="name">pr.flow.requisition.form</field>
        <field name="model">pr.flow.requisition</field>
        <field name="arch" type="xml">
            <form string="Purchase Requisition">
                <header>
                    <button name="action_submit" string="Submit for Approval"
                            type="object" class="oe_highlight"
                            invisible="state != 'draft'"/>

                    <button name="action_dept_approve" string="Department Approve"
                            type="object" class="oe_highlight"
                            invisible="state != 'submitted'"
                            groups="pr_flow_mgmt.group_pr_manager"/>

                    <button name="action_manager_approve" string="Manager Approve"
                            type="object" class="oe_highlight"
                            invisible="state != 'dept_approved'"
                            groups="pr_flow_mgmt.group_pr_director"/>

                    <button name="action_create_purchase_order" string="Create Purchase Order"
                            type="object" class="oe_highlight"
                            invisible="state != 'approved'"
                            groups="pr_flow_mgmt.group_pr_manager"/>

                    <button name="action_reject" string="Reject"
                            type="object"
                            invisible="state not in ['submitted', 'dept_approved', 'manager_approved']"
                            groups="pr_flow_mgmt.group_pr_manager"/>

                    <button name="action_cancel" string="Cancel"
                            type="object"
                            invisible="state in ['cancelled', 'done']"/>

                    <button name="action_draft" string="Set to Draft"
                            type="object"
                            invisible="state not in ['rejected', 'cancelled']"/>

                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,dept_approved,manager_approved,approved,done"/>
                </header>

                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_purchase_orders" type="object"
                                class="oe_stat_button" icon="fa-shopping-cart"
                                invisible="purchase_count == 0">
                            <field name="purchase_count" widget="statbutton" string="Purchase Orders"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group name="requisition_info">
                            <field name="user_id" readonly="state != 'draft'"/>
                            <field name="department_id" readonly="state != 'draft'"/>
                            <field name="priority" widget="priority" readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                        </group>
                        <group name="dates">
                            <field name="date_request" readonly="state != 'draft'"/>
                            <field name="date_required" readonly="state != 'draft'"/>
                            <field name="date_approved" readonly="1" invisible="state not in ['approved', 'done']"/>
                        </group>
                    </group>

                    <group name="approval_info" invisible="state == 'draft'">
                        <group>
                            <field name="dept_manager_id" readonly="1" invisible="state == 'submitted'"/>
                            <field name="manager_id" readonly="1"
                                   invisible="state in ['draft', 'submitted', 'dept_approved']"/>
                        </group>
                        <group>
                            <field name="approved_by_id" readonly="1" invisible="state not in ['approved', 'done']"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Products" name="products">
                            <field name="line_ids" mode="list" readonly="state not in ['draft', 'rejected']">
                                <list string="Requisition Lines" editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id" required="1"/>
                                    <field name="description"/>
                                    <field name="quantity"/>
                                    <field name="uom_id" groups="uom.group_uom"/>
                                    <field name="estimated_price"/>
                                    <field name="subtotal" sum="total"/>
                                    <field name="vendor_id"/>
                                    <field name="stock_available" optional="show"/>
                                    <field name="date_required" optional="hide"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="product_uom_category_id" column_invisible="1"/>
                                </list>
                            </field>

                            <group class="oe_subtotal_footer oe_right">
                                <field name="estimated_amount" widget="monetary"/>
                                <field name="currency_id" column_invisible="1"/>
                            </group>
                        </page>

                        <page string="Other Information" name="other_info">
                            <group>
                                <group>
                                    <field name="description"
                                           placeholder="Describe the purpose of this requisition..."/>
                                </group>
                                <group>
                                    <field name="notes" placeholder="Internal notes..."/>
                                    <field name="rejection_reason" readonly="1" invisible="state != 'rejected'"/>
                                </group>
                            </group>
                        </page>

                        <page string="Purchase Orders" name="purchase_orders" invisible="purchase_count == 0">
                            <field name="purchase_order_ids" mode="list" readonly="1">
                                <list string="Purchase Orders" create="0" delete="0">
                                    <field name="name"/>
                                    <field name="partner_id"/>
                                    <field name="date_order"/>
                                    <field name="amount_total"/>
                                    <field name="state" widget="badge" decoration-success="state == 'purchase'"
                                           decoration-info="state == 'draft'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>

                    <field name="is_editable" invisible="1"/>
                    <field name="require_dept_approval" invisible="1"/>
                    <field name="require_manager_approval" invisible="1"/>
                    <field name="line_count" invisible="1"/>
                </sheet>

                <chatter/>
            </form>
        </field>
    </record>

    <!-- Purchase Requisition List View (Odoo 18: using 'list' instead of 'tree') -->
    <record id="view_pr_flow_requisition_list" model="ir.ui.view">
        <field name="name">pr.flow.requisition.list</field>
        <field name="model">pr.flow.requisition</field>
        <field name="arch" type="xml">
            <list string="Purchase Requisitions"
                  decoration-info="state == 'draft'"
                  decoration-warning="state == 'submitted'"
                  decoration-success="state == 'approved'"
                  decoration-muted="state in ['cancelled', 'rejected']"
                  multi_edit="1">
                <field name="name" readonly="1"/>
                <field name="user_id"/>
                <field name="department_id"/>
                <field name="date_request"/>
                <field name="date_required"/>
                <field name="priority" widget="priority"/>
                <field name="estimated_amount" sum="total" widget="monetary"/>
                <field name="line_count"/>
                <field name="state" widget="badge"
                       decoration-info="state in ['draft', 'submitted']"
                       decoration-warning="state in ['dept_approved', 'manager_approved']"
                       decoration-success="state in ['approved', 'done']"
                       decoration-danger="state == 'rejected'"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Purchase Requisition Search View -->
    <record id="view_pr_flow_requisition_search" model="ir.ui.view">
        <field name="name">pr.flow.requisition.search</field>
        <field name="model">pr.flow.requisition</field>
        <field name="arch" type="xml">
            <search string="Purchase Requisitions">
                <field name="name" string="Reference"
                       filter_domain="[('name', 'ilike', self)]"/>
                <field name="user_id" string="Requested By"/>
                <field name="department_id" string="Department"/>
                <field name="state" string="Status"/>

                <filter string="My Requisitions" name="my_requisitions"
                        domain="[('user_id', '=', uid)]"/>
                <filter string="My Department" name="my_department"
                        domain="[('department_id.member_ids', 'in', [uid])]"/>

                <separator/>
                <filter string="Draft" name="draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter string="Submitted" name="submitted"
                        domain="[('state', '=', 'submitted')]"/>
                <filter string="Pending Approval" name="pending_approval"
                        domain="[('state', 'in', ['submitted', 'dept_approved', 'manager_approved'])]"/>
                <filter string="Approved" name="approved"
                        domain="[('state', '=', 'approved')]"/>
                <filter string="Done" name="done"
                        domain="[('state', '=', 'done')]"/>

                <separator/>
                <filter string="Urgent" name="urgent"
                        domain="[('priority', 'in', ['1', '2'])]"/>
                <filter string="This Month" name="this_month"
                        domain="[('date_request', '&gt;=', (context_today() - relativedelta(day=1)).strftime('%Y-%m-%d')),
                                 ('date_request', '&lt;', (context_today() + relativedelta(months=1, day=1)).strftime('%Y-%m-%d'))]"/>

<!--                <group expand="0" string="Group By">-->
<!--                    <filter string="Requested By" name="group_user"-->
<!--                            context="{'group_by': 'user_id'}"/>-->
<!--                    <filter string="Department" name="group_department"-->
<!--                            context="{'group_by': 'department_id'}"/>-->
<!--                    <filter string="Status" name="group_state"-->
<!--                            context="{'group_by': 'state'}"/>-->
<!--                    <filter string="Request Date" name="group_date_request"-->
<!--                            context="{'group_by': 'date_request'}"/>-->
<!--                    <filter string="Required Date" name="group_date_required"-->
<!--                            context="{'group_by': 'date_required'}"/>-->
<!--                </group>-->
            </search>
        </field>
    </record>

    <!-- Purchase Requisition Kanban View -->
    <record id="view_pr_flow_requisition_kanban" model="ir.ui.view">
        <field name="name">pr.flow.requisition.kanban</field>
        <field name="model">pr.flow.requisition</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile"
                    default_group_by="state"
                    quick_create="false">
                <field name="name"/>
                <field name="user_id"/>
                <field name="department_id"/>
                <field name="date_required"/>
                <field name="estimated_amount"/>
                <field name="state"/>
                <field name="priority"/>
                <field name="currency_id"/>

                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_card_header">
                                <div class="o_kanban_card_header_title">
                                    <div class="o_primary">
                                        <strong>
                                            <field name="name"/>
                                        </strong>
                                    </div>
                                    <div class="o_secondary">
                                        <field name="department_id"/>
                                    </div>
                                </div>
                            </div>

                            <div class="o_kanban_card_content">
                                <div class="o_kanban_record_body">
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                    <div class="mt4">
                                        <i class="fa fa-calendar" role="img" aria-label="Date" title="Date"/>
                                        <field name="date_required"/>
                                    </div>
                                    <div class="mt4">
                                        <i class="fa fa-money" role="img" aria-label="Amount" title="Amount"/>
                                        <field name="estimated_amount" widget="monetary"/>
                                    </div>
                                </div>
                            </div>

                            <div class="o_kanban_card_footer">
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="priority" widget="priority"/>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <field name="state" widget="label_selection"
                                               options="{'classes': {'draft': 'info', 'approved': 'success', 'rejected': 'danger'}}"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Purchase Requisition Pivot View -->
    <record id="view_pr_flow_requisition_pivot" model="ir.ui.view">
        <field name="name">pr.flow.requisition.pivot</field>
        <field name="model">pr.flow.requisition</field>
        <field name="arch" type="xml">
            <pivot string="Requisition Analysis">
                <field name="department_id" type="row"/>
                <field name="date_request" interval="month" type="col"/>
                <field name="estimated_amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Purchase Requisition Graph View -->
    <record id="view_pr_flow_requisition_graph" model="ir.ui.view">
        <field name="name">pr.flow.requisition.graph</field>
        <field name="model">pr.flow.requisition</field>
        <field name="arch" type="xml">
            <graph string="Requisition Analysis" type="bar" stacked="True">
                <field name="department_id"/>
                <field name="estimated_amount" type="measure"/>
                <field name="state"/>
            </graph>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_pr_flow_requisition" model="ir.actions.act_window">
        <field name="name">Purchase Requisitions</field>
        <field name="res_model">pr.flow.requisition</field>
        <field name="view_mode">list,kanban,form,pivot,graph</field>
        <field name="context">{'search_default_my_requisitions': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Purchase Requisition
            </p>
            <p>
                Purchase requisitions help you manage material and service requests
                with a structured approval workflow.
            </p>
        </field>
    </record>

    <record id="action_pr_flow_requisition_to_approve" model="ir.actions.act_window">
        <field name="name">Requisitions to Approve</field>
        <field name="res_model">pr.flow.requisition</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_pending_approval': 1}</field>
        <field name="domain">[('state', 'in', ['submitted', 'dept_approved', 'manager_approved'])]</field>
    </record>

</odoo>