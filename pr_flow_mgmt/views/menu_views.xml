<odoo>

    <!-- Main Menu -->
    <menuitem id="menu_pr_flow_root"
              name="Purchase Requisitions"
              sequence="10"
              web_icon="pr_flow_mgmt,static/description/icon.png"
              groups="pr_flow_mgmt.group_pr_user"/>

    <!-- Requisitions Menu -->
    <menuitem id="menu_pr_flow_requisitions"
              name="Requisitions"
              parent="menu_pr_flow_root"
              sequence="10"/>

    <menuitem id="menu_pr_flow_requisition_all"
              name="All Requisitions"
              parent="menu_pr_flow_requisitions"
              action="action_pr_flow_requisition"
              sequence="10"/>

    <menuitem id="menu_pr_flow_requisition_to_approve"
              name="To Approve"
              parent="menu_pr_flow_requisitions"
              action="action_pr_flow_requisition_to_approve"
              sequence="20"
              groups="pr_flow_mgmt.group_pr_manager"/>

    <!-- Configuration Menu -->
    <menuitem id="menu_pr_flow_configuration"
              name="Configuration"
              parent="menu_pr_flow_root"
              sequence="100"
              groups="pr_flow_mgmt.group_pr_admin"/>

    <menuitem id="menu_pr_flow_settings"
              name="Settings"
              parent="menu_pr_flow_configuration"
              action="base_setup.action_general_configuration"
              sequence="10"
              groups="pr_flow_mgmt.group_pr_admin"/>

</odoo>