<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="paystack_form" name="Paystack Payment Form">
        <form t-att-action="api_url" method="get">
            <script type="text/javascript">
                // Redirect immediately to Paystack
                window.location.href = '<t t-esc="api_url"/>';
            </script>
            <!-- Fallback button in case JavaScript is disabled -->
            <button type="submit" class="btn btn-primary" style="display: none;">
                Proceed to Payment
            </button>
        </form>
    </template>
</odoo>