<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="payment_provider_form" model="ir.ui.view">
        <field name="name">payment.provider.form.paystack</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='provider_credentials']" position="inside">
                <group invisible="code != 'paystack'">
                    <field name="paystack_public_key"
                           placeholder="pk_test_xxxxxxxxxxxxxxxxxxxx"
                           required="code == 'paystack' and state != 'disabled'"/>
                    <field name="paystack_secret_key"
                           password="True"
                           placeholder="sk_test_xxxxxxxxxxxxxxxxxxxx"
                           required="code == 'paystack' and state != 'disabled'"/>
                </group>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="attributes">
                <attribute name="invisible">0</attribute>
            </xpath>
        </field>
    </record>
</odoo>